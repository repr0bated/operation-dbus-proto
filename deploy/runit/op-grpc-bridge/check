#!/bin/sh
# op-grpc-bridge readiness — socket exists + accepts a connect (no socat).
SOCK="/run/opdbus/grpc.sock"
[ -S "$SOCK" ] || exit 1
perms=$(stat -c '%a' "$SOCK" 2>/dev/null)
if [ "$perms" != "777" ]; then
    chmod 777 "$SOCK" 2>/dev/null || exit 1
fi
exec python3 -c 'import socket,sys; s=socket.socket(socket.AF_UNIX); s.settimeout(1); s.connect(sys.argv[1]); s.close()' "$SOCK"
