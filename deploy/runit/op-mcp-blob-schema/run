#!/bin/sh
exec 2>&1
set -a
for entry in /etc/runit/sv/op-mcp-blob-schema/env/*; do
  [ -f "$entry" ] || continue
  key=${entry##*/}
  IFS= read -r value < "$entry" || value=
  export "$key=$value"
done
set +a
install -d -m 0755 /run/opdbus
exec /usr/local/bin/op-mcp-server \
  --mode "${OP_MCP_MODE:-blob-schema}" \
  --http "${OP_MCP_HTTP:-127.0.0.1:11438}" \
  --unix "${OP_MCP_UNIX:-/run/opdbus/mcp-blob-schema.sock}" \
  --wg-interface "${WG_INTERFACE:-netmaker}" \
  --log-level "${OP_MCP_LOG_LEVEL:-info}"
