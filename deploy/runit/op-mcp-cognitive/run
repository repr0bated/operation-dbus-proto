#!/bin/sh
# Fan-in MCP for tched-router. Talks to cognitive_mcp via the bridge socket.
# Do NOT exec op-cognitive-mcp --stdio (second Cozo lock).
exec 2>&1
set -a
for entry in /etc/runit/sv/op-mcp-cognitive/env/*; do
  [ -f "$entry" ] || continue
  key=${entry##*/}
  IFS= read -r value < "$entry" || value=
  export "$key=$value"
done
set +a
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/opdbus/session-bus.sock}"
install -d -m 0755 /run/opdbus
exec /usr/local/bin/op-mcp-server \
  --mode "${OP_MCP_MODE:-cognitive}" \
  --unix "${OP_MCP_UNIX:-/run/opdbus/mcp-cognitive.sock}" \
  --wg-interface "${WG_INTERFACE:-netmaker}" \
  --log-level "${OP_MCP_LOG_LEVEL:-info}"
