#!/bin/sh
# Mail publication, NIC-less. Host TCP -> shared UDS -> mail CT loopback.
#
# The mail CT has no `nic` and no `proxy` device: the ONLY channel into it is
# the bind-mounted /run/ghostbridge directory. `mail-uds-relay` (openrc, inside
# the CT) publishes each daemon port as a socket under /run/ghostbridge/mail/;
# this unit binds the public and mesh addresses and forwards into those sockets.
#
# Replaces mail-port-fabric.py, which forwarded to 127.0.0.1:<port> on the HOST
# and therefore depended on per-port Incus proxy devices. Those devices are gone
# by design, which is exactly why mail broke: every listener accepted and then
# dead-ended. Do not reintroduce them.
exec 2>&1

GB=/run/ghostbridge/mail
RELAY=/usr/local/libexec/3tched/op-uds-relay

# Comma-separated publication addresses: pub0 + netmaker mesh.
MAIL_BIND_ADDRS="${MAIL_BIND_ADDRS:-188.68.58.237,100.69.0.1}"

wait_dep() {
    sv start "$1" >/dev/null 2>&1 || true
    i=0
    until sv check "$1" >/dev/null 2>&1; do
        i=$((i + 1))
        [ "$i" -ge 90 ] && { echo "dependency $1 not ready" >&2; exit 1; }
        sleep 1
    done
}

wait_dep opdbus-rundirs
wait_dep incus-ct-mail-3tched
sv start netclient >/dev/null 2>&1 || true

# The mesh address must exist before binding it, or the listener silently
# publishes on fewer addresses than intended (the sshd failure mode).
until ip -4 addr show netmaker 2>/dev/null | grep -q "100.69.0.1/"; do
    echo "mail-port-fabric: waiting for 100.69.0.1 on netmaker"
    sleep 1
done

# The CT-side relay creates these; without them there is nothing to forward to.
i=0
for s in smtp imap smtps submission imaps php; do
    until [ -S "$GB/$s.sock" ]; do
        i=$((i + 1))
        [ "$i" -ge 180 ] && { echo "CT socket $s.sock never appeared" >&2; exit 1; }
        sleep 1
    done
done

set --
# Mail protocols: published on every bind address.
for spec in 25:smtp 143:imap 465:smtps 587:submission 993:imaps; do
    port="${spec%%:*}"
    name="${spec##*:}"
    OLDIFS="$IFS"; IFS=,
    for addr in $MAIL_BIND_ADDRS; do
        IFS="$OLDIFS"
        [ -n "$addr" ] && set -- "$@" --tcp-to-unix "$addr:$port=$GB/$name.sock"
        IFS=,
    done
    IFS="$OLDIFS"
done

# PHP-FPM (SnappyMail backend) stays mesh-only — never published on pub0.
set -- "$@" --tcp-to-unix "100.69.0.1:9000=$GB/php.sock"
set -- "$@" --unix-to-tcp "$GB/outbound-smtp.sock=100.69.0.2:25"

/usr/local/libexec/3tched/runit-ready-signal mail-port-fabric 2>/dev/null || true
exec "$RELAY" "$@"
