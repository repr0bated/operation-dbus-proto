#!/bin/sh
exec 2>&1
# Netmaker API on the shared 3tched ingress port.
until ss -lnt | grep -q "127.0.0.1:8081"; do sleep 1; done
until ip -4 addr show 3tched 2>/dev/null | grep -q "10.0.0.2/"; do sleep 1; done
/usr/local/libexec/3tched/runit-ready-signal fwd-nm-tonic-8081 2>/dev/null || true
exec /usr/local/libexec/3tched/socket-relay tcp-listen 10.0.0.2 8081 tcp-connect 127.0.0.1 8081
