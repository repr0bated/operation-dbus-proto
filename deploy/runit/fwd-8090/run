#!/bin/sh
exec 2>&1
TONIC_PORT=8090
sv start dbus >/dev/null 2>&1 || true
sv start op-session-bus >/dev/null 2>&1 || true
until ip -4 addr show dev svc0 2>/dev/null | grep -q "10.0.0.3/"; do sleep 1; done
until ss -lnt | grep -q "127.0.0.1:${TONIC_PORT}"; do sleep 1; done
i=0
until grep -q "10.0.0.3" /proc/net/fib_trie 2>/dev/null; do
    i=$((i+1))
    [ "$i" -ge 120 ] && break
    sleep 1
done
exec /usr/local/libexec/3tched/socket-relay tcp-listen 10.0.0.3 "$TONIC_PORT" tcp-connect 127.0.0.1 "$TONIC_PORT"
