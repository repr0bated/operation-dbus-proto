#!/bin/sh
exec 2>&1
[ -r /etc/op-dbus/netmaker-broker.env ] && . /etc/op-dbus/netmaker-broker.env
BROKER_PORT="${NETMAKER_BROKER_PORT:-8090}"
sv start dbus >/dev/null 2>&1 || true
sv start op-session-bus >/dev/null 2>&1 || true
until [ -d /sys/class/net/svc0 ]; do sleep 1; done
until ss -lnt | grep -q "127.0.0.1:${BROKER_PORT}"; do sleep 1; done
i=0
until grep -q "10.0.0.2" /proc/net/fib_trie 2>/dev/null; do
    i=$((i+1))
    [ "$i" -ge 120 ] && break
    sleep 1
done
exec /usr/local/libexec/3tched/socket-relay tcp-listen 10.0.0.2 "$BROKER_PORT" tcp-connect 127.0.0.1 "$BROKER_PORT"
