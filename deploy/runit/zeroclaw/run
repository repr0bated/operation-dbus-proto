#!/bin/sh
exec 2>&1
set -eu

CONFIG_DIR=${ZEROCLAW_CONFIG_DIR:-/var/lib/zeroclaw}
BOOTSTRAP_CONFIG=${ZEROCLAW_BOOTSTRAP_CONFIG:-/etc/op-dbus/zeroclaw-runtime.toml}
BOOTSTRAP_SKILLS=${ZEROCLAW_BOOTSTRAP_SKILLS:-/etc/op-dbus/zeroclaw-skills/default}
AUTH_FILE=${OPENCODE_AUTH_FILE:-/home/jeremy/.local/share/opencode/auth.json}
NATIVE_BIN=${TCHED_ROUTER_NATIVE_BIN:-/usr/bin/zeroclaw}
NATIVE_MANIFEST=${TCHED_ROUTER_NATIVE_MANIFEST:-/usr/share/op-dbus/native-manifests/tched-router.json}

[ -x "$NATIVE_BIN" ] || { echo "pinned tched_router native binary is missing" >&2; exit 78; }
[ -f "$NATIVE_MANIFEST" ] || { echo "tched_router native provenance manifest is missing" >&2; exit 78; }
manifest_format=$(jq -er '.format' "$NATIVE_MANIFEST")
manifest_commit=$(jq -er '.upstream.commit' "$NATIVE_MANIFEST")
manifest_binary_sha256=$(jq -er '.artifact.sha256' "$NATIVE_MANIFEST")
[ "$manifest_format" = opdbus.tched-router-native.v1 ] || {
    echo "tched_router native provenance format is unsupported" >&2
    exit 78
}
[ "$manifest_commit" = a56c345d51dd8ab562e9351e0d4ab83f6a741db9 ] || {
    echo "tched_router native provenance has the wrong upstream commit" >&2
    exit 78
}
actual_binary_sha256=$(sha256sum "$NATIVE_BIN" | awk '{print $1}')
[ "$actual_binary_sha256" = "$manifest_binary_sha256" ] || {
    echo "tched_router native binary differs from its provenance manifest" >&2
    exit 78
}
[ "$($NATIVE_BIN --version)" = "zeroclaw 0.8.4" ] || {
    echo "tched_router native binary reports an unexpected version" >&2
    exit 78
}

install -d -o jeremy -g jeremy -m 0700 "$CONFIG_DIR"
if [ ! -f "$CONFIG_DIR/config.toml" ]; then
    install -o jeremy -g jeremy -m 0600 "$BOOTSTRAP_CONFIG" "$CONFIG_DIR/config.toml"
fi

# Seed/refresh drill-down skills under the default bundle (zeroclaw owns the surface).
if [ -d "$BOOTSTRAP_SKILLS" ]; then
    install -d -o jeremy -g jeremy -m 0755 "$CONFIG_DIR/shared/skills/default"
    cp -a "$BOOTSTRAP_SKILLS"/. "$CONFIG_DIR/shared/skills/default/"
    chown -R jeremy:jeremy "$CONFIG_DIR/shared/skills/default"
fi

exec chpst -u jeremy:jeremy env -i \
    HOME=/home/jeremy \
    USER=jeremy \
    PATH=/usr/local/bin:/usr/bin:/bin \
    ZEROCLAW_CONFIG_DIR="$CONFIG_DIR" \
    TCHED_ROUTER_NATIVE_BIN="$NATIVE_BIN" \
    OPENCODE_AUTH_FILE="$AUTH_FILE" \
    sh -c '
        set -eu
        OPENCODE_API_KEY=$(jq -er '\''.["opencode-go"].key | strings | select(length > 0)'\'' "$OPENCODE_AUTH_FILE")
        export OPENCODE_API_KEY
        unset OPENCODE_AUTH_FILE
        exec "$TCHED_ROUTER_NATIVE_BIN" daemon \
            --config-dir "$ZEROCLAW_CONFIG_DIR" \
            --host 127.0.0.1 \
            --port 8082 \
            --log-level warn
    '
