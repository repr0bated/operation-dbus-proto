#!/bin/sh
exec 2>&1
until [ -d /run/ghostbridge ]; do sleep 1; done
until ss -lnt | grep -q "127.0.0.1:8440"; do sleep 1; done
/usr/local/libexec/3tched/runit-ready-signal mail-web-socket 2>/dev/null || true
SOCK=/run/ghostbridge/mail-web.sock
rm -f "$SOCK"
if [ -S /run/opdbus/session-bus.sock ]; then
  zcall shared_unix_socket create_unix_socket -a '{"name":"mail-web","ports":[443,8440]}' >/dev/null 2>&1 || true
fi
exec /usr/local/libexec/3tched/socket-relay unix-listen "$SOCK" tcp-connect 127.0.0.1 8440
