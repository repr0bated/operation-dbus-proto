#!/bin/sh
exec 2>&1
NAME='assistant'
# If still running after run exited, stop it (avoid orphan CT)
if incus list -f csv -c ns 2>/dev/null | grep -q "^${NAME},RUNNING$"; then
    echo "finish: stopping leftover $NAME"
    incus stop "$NAME" --timeout 20 2>/dev/null || incus stop "$NAME" --force 2>/dev/null || true
fi
exit 0
