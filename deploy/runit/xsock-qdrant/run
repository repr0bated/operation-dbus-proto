#!/bin/sh
exec 2>&1
until [ -d /run/ghostbridge ]; do sleep 1; done
/usr/local/libexec/3tched/runit-ready-signal xsock-qdrant
rm -f /run/ghostbridge/fwd-qdrant.sock
if [ -S /run/opdbus/session-bus.sock ]; then
  zcall shared_unix_socket create_unix_socket -a '{"name":"xsock-qdrant","ports":[6333]}' >/dev/null 2>&1 || true
fi
exec /usr/local/libexec/3tched/socket-relay unix-listen /run/ghostbridge/fwd-qdrant.sock tcp-connect 10.200.0.2 6333
