#!/bin/sh
# tched-router readiness — the loopback gateway LISTENER, not just the pid.
# The ready token is written before exec, so it only proves the run script got
# past its seeding phase; the port test proves the official binary bound.
[ -f /run/opdbus/runit-ready/tched-router ] || exit 1

set -a
[ -r /etc/op-dbus/environment ] && . /etc/op-dbus/environment
set +a
CONFIG_DIR="${TCHED_ROUTER_CONFIG_DIR:-/var/lib/tched-router}"
PORT="${TCHED_ROUTER_PORT:-8084}"

pgrep -f "zeroclaw daemon --config-dir $CONFIG_DIR" >/dev/null 2>&1 || exit 1
ss -lnt "sport = :$PORT" 2>/dev/null | grep -q LISTEN
