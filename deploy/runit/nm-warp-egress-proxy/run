#!/bin/sh
# runit: NetMaker egress HTTP CONNECT proxy. NetMaker (NIC-less CT) -> incus
# proxy3128 -> this listener on 127.0.0.1:13128 -> upstream sockets marked
# 0x51821 -> WARP egress. Depends on wgcf-egress for the marked route.
exec 2>&1
i=0
until ip link show wgcf-egress >/dev/null 2>&1; do
    i=$((i+1))
    [ "$i" -ge 60 ] && { echo "wgcf-egress not up after 60s; starting proxy anyway" >&2; break; }
    sleep 1
done
exec /usr/local/libexec/3tched/nm-warp-egress-proxy.py 127.0.0.1 13128
