#!/bin/sh
exec 2>&1
# Netmaker MQTT broker on svc0 (same tonic entrance as API).
until ss -lnt | grep -q "127.0.0.1:8083"; do sleep 1; done
until ip -4 addr show svc0 2>/dev/null | grep -q "10.0.0.2/"; do sleep 1; done
/usr/local/libexec/3tched/runit-ready-signal fwd-nm-broker-8083 2>/dev/null || true
exec /usr/local/libexec/3tched/socket-relay tcp-listen 10.0.0.2 8083 tcp-connect 127.0.0.1 8083
