#!/bin/sh
exec 2>&1
ssh-keygen -A >/dev/null 2>&1 # Will generate host keys if they don't already exist
[ -r conf ] && . ./conf
# Administrative SSH is loopback-only.  The decoy's persistent reverse tunnel
# exposes it at the decoy loopback without creating another network carrier.
exec /usr/bin/sshd -D -e $OPTS
