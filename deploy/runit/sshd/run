#!/bin/sh
exec 2>&1
ssh-keygen -A >/dev/null 2>&1 # Will generate host keys if they don't already exist
[ -r conf ] && . ./conf

# Public listen is in sshd_config.d/90-singleuser-password.conf
# (ListenAddress 0.0.0.0). Do not wait on 100.69.0.1 — netclient/EMQX
# must not gate rescue SSH. Optional mesh bind can be added later once
# that address exists; sshd skips missing ListenAddress values.
#
# Wait BOUNDED for the mesh address only as a nicety. Always start.
MESH_IP="${SSHD_WAIT_ADDR:-100.69.0.1}"
i=0
while [ "$i" -lt 5 ]; do
    if ip -4 -o addr show 2>/dev/null | awk '{print $4}' | cut -d/ -f1 \
        | grep -qx "$MESH_IP"; then
        break
    fi
    i=$((i + 1))
    sleep 1
done

exec /usr/bin/sshd -D -e $OPTS
