#!/bin/sh
# Retired: Qdrant HTTP is container-local only. The published door is gRPC
# (uds-qdrant-grpc → 10.200.0.2:6334). Leave this service down.
# NIC-less publication: host TCP -> ghostbridge UDS -> container loopback.
# Replaces the Incus proxy device that used to bind 10.0.0.2:6333. Same listen
# address, so consumers are unaffected; only the mechanism changed.
exec 2>&1
until [ -S "/run/ghostbridge/qdrant/http.sock" ]; do
    echo "uds-qdrant-http-svc0: waiting for CT socket /run/ghostbridge/qdrant/http.sock"
    sleep 1
done
/usr/local/libexec/3tched/runit-ready-signal uds-qdrant-http-svc0 2>/dev/null || true
exec /usr/local/libexec/3tched/op-uds-relay --tcp-to-unix "10.0.0.2:6333=/run/ghostbridge/qdrant/http.sock"
