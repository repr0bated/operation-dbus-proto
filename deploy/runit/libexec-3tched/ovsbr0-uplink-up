#!/bin/sh
# ovsbr0-uplink — verify the seeded topology. It does not build anything.
#
# It used to call op-ovsbr0-setup and then `ovsdb-port del-port $PHYS` to keep
# the uplink OUT of the bridge for a later cutover. With the seed enslaving the
# uplink in the same transaction that creates the bridge, that detach actively
# undid the seed and re-opened the race it exists to close. Both are gone.
set -eu
export PATH="/usr/local/bin:/usr/bin:/usr/sbin:${PATH:-}"
set -a; [ -r /etc/op-dbus/network.conf ] && . /etc/op-dbus/network.conf; set +a
BRIDGE="${BRIDGE:-ovsbr0}"
PHYS="${UPLINK_PHYS:-eth0}"

i=0
until [ -d "/sys/class/net/$BRIDGE" ]; do
    i=$((i+1))
    [ "$i" -ge 30 ] && { echo "ovsbr0-uplink: $BRIDGE did not appear — seed broken" >&2; exit 1; }
    sleep 1
done

for p in $PHYS ${PUBLIC_PORT:-pub0} ${INTERNAL_PORTS:-svc0 grpc0}; do
    i=0
    until [ -d "/sys/class/net/$p" ]; do
        i=$((i+1))
        [ "$i" -ge 30 ] && { echo "ovsbr0-uplink: port $p missing from $BRIDGE — seed incomplete" >&2; exit 1; }
        sleep 1
    done
done

echo "ovsbr0-uplink: $BRIDGE seeded with $PHYS ${PUBLIC_PORT:-pub0} ${INTERNAL_PORTS:-svc0 grpc0}"
