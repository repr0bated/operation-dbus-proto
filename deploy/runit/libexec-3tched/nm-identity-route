#!/bin/sh
# Keep identity host 10.0.0.3 reachable via decoy, not on-link svc0.
# netclient pull recreates 10.0.0.0/24 on svc0 and deletes this /32.
set -eu
export PATH="/usr/bin:/usr/sbin:${PATH:-}"
set -a; [ -r /etc/op-dbus/network.conf ] && . /etc/op-dbus/network.conf; set +a
HOST="${IDENTITY_HOST:-10.10.0.5}"
VIA="${IDENTITY_VIA:-100.69.0.2}"
DEV="${IDENTITY_DEV:-netmaker}"

ensure() {
    [ -d "/sys/class/net/$DEV" ] || return 0
    ip -4 addr show "$DEV" 2>/dev/null | grep -q 'inet ' || return 0
    cur=$(ip -4 route show "$HOST" 2>/dev/null || true)
    case "$cur" in
        *via\ "$VIA"*"dev $DEV"*) return 0 ;;
    esac
    ip route replace "$HOST/32" via "$VIA" dev "$DEV" 2>/dev/null || true
}

while :; do
    ensure
    sleep 2
done
