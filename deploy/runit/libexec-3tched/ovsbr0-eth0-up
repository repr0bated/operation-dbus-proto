#!/bin/sh
# ovsbr0-eth0 — the atomic cutover. This is the only step that touches the
# host's path to the network, and it owns both halves of it.
#
# Ordering is the whole design: eth0 comes up and DHCPs OUTSIDE OVS, so the
# lease is real and current. Only then is it enslaved, and the address it just
# learned moves to pub0 in the same breath. eth0 is deliberately NOT persisted
# in conf.db — if it were, vswitchd would capture it at startup and there would
# never be a lease to read.
#
# Sequence, and why it is this order:
#   1. pub0 takes eth0's MAC. The provider filters on it, and pub0 is about to
#      carry the public address. Safe to do early — eth0 is still live.
#   2. add-port eth0 (one OVSDB transact). If this fails, nothing has changed:
#      eth0 keeps its address and the box stays up. Clean abort.
#   3. one `ip -batch` moving addresses + default route eth0 -> pub0. The kernel
#      strips eth0's addresses when it is enslaved, so this is what ends the
#      outage; batching it means there is no ordering gap inside the move.
#
# Native tooling only. The plugin tree (zcall) is the LAST thing to start, by
# design, so it cannot be available here.
set -eu
export PATH="/usr/local/bin:/usr/bin:/usr/sbin:${PATH:-}"
set -a; [ -r /etc/op-dbus/network.conf ] && . /etc/op-dbus/network.conf; set +a

BRIDGE="${BRIDGE:-ovsbr0}"
PHYS="${UPLINK_PHYS:-eth0}"
PUB="${PUBLIC_PORT:-pub0}"
OVSDB_PORT=/usr/local/libexec/3tched/ovsdb-port

[ -d "/sys/class/net/$BRIDGE" ] || { echo "ovsbr0-eth0: bridge $BRIDGE missing — conf.db topology is wrong" >&2; exit 1; }
[ -d "/sys/class/net/$PUB" ] || { echo "ovsbr0-eth0: $PUB missing — conf.db topology is wrong" >&2; exit 1; }
[ -d "/sys/class/net/$PHYS" ] || { echo "ovsbr0-eth0: physical port $PHYS missing" >&2; exit 1; }

# --- Already cut over? Then only make sure pub0 still holds the address. ---
if [ "$("$OVSDB_PORT" port-to-br "$PHYS" 2>/dev/null || true)" = "$BRIDGE" ]; then
    "$OVSDB_PORT" set-mtu "$PHYS" "${BRIDGE_MTU:-1420}"
    "$OVSDB_PORT" set-mtu "$PUB" "${BRIDGE_MTU:-1420}"
    if ip -4 -o addr show dev "$PUB" scope global | grep -q .; then
        echo "ovsbr0-eth0: $PHYS already on $BRIDGE, $PUB addressed — nothing to do"
        exit 0
    fi
    echo "ovsbr0-eth0: $PHYS enslaved but $PUB has no address — reapplying from snapshot" >&2
fi

# --- Capture. The live lease on eth0 wins; snapshot, then static, as fallback.
ADDRS="$(ip -4 -o addr show dev "$PHYS" scope global | awk '{print $4}' | tr '\n' ' ')"
GW="$(ip -4 route show default dev "$PHYS" 2>/dev/null | awk '{print $3; exit}')"

if [ -z "$ADDRS" ]; then
    SNAPSHOT=/run/opdbus/uplink-migration.env
    UPLINK_ADDRS=""; UPLINK_GW=""
    # shellcheck disable=SC1090
    [ -r "$SNAPSHOT" ] && . "$SNAPSHOT"
    ADDRS="$UPLINK_ADDRS"
    [ -n "$GW" ] || GW="$UPLINK_GW"
fi
[ -n "$ADDRS" ] || ADDRS="${PUBLIC_ADDR:-}"
[ -n "$GW" ] || GW="${PUBLIC_GW:-}"

[ -n "$ADDRS" ] || { echo "ovsbr0-eth0: no address to migrate — refusing to enslave $PHYS" >&2; exit 1; }
echo "ovsbr0-eth0: migrating $ADDRS (gw ${GW:-none}) from $PHYS to $PUB"

# --- 1. pub0 wears the uplink's MAC before it carries the uplink's address. ---
MAC="$(cat "/sys/class/net/$PHYS/address")"
if [ "$(cat "/sys/class/net/$PUB/address" 2>/dev/null)" != "$MAC" ]; then
    ip link set dev "$PUB" address "$MAC"
    echo "ovsbr0-eth0: $PUB hwaddr set to $MAC"
fi

# --- 2. Enslave. Nothing has moved yet, so a failure here is harmless. ---
"$OVSDB_PORT" add-port "$BRIDGE" "$PHYS"
"$OVSDB_PORT" set-mtu "$PHYS" "${BRIDGE_MTU:-1420}"
"$OVSDB_PORT" set-mtu "$PUB" "${BRIDGE_MTU:-1420}"
ip link set dev "$PHYS" up

# --- 3. One batch: the address and the route land together. ---
BATCH="$(mktemp /run/ovsbr0-cutover.XXXXXX)"
trap 'rm -f "$BATCH"' EXIT
{
    echo "link set dev $PUB up"
    for a in $ADDRS; do
        echo "addr del $a dev $PHYS"
        echo "addr add $a dev $PUB"
    done
    [ -n "$GW" ] && echo "route replace default via $GW dev $PUB onlink"
} >"$BATCH"

# `ip -batch` without -force aborts on the first failing line, leaving the rest
# unapplied — which is what we want; a half-applied move is worse than none.
# addr del may legitimately fail if the kernel already stripped it on enslave,
# so that one case is tolerated by re-running with the dels dropped.
if ! ip -batch "$BATCH" 2>/dev/null; then
    echo "ovsbr0-eth0: batch failed (uplink likely stripped on enslave) — applying adds only" >&2
    grep -v '^addr del ' "$BATCH" >"$BATCH.adds"
    ip -batch "$BATCH.adds"
    rm -f "$BATCH.adds"
fi

echo "ovsbr0-eth0: $PHYS on $BRIDGE, $ADDRS on $PUB, default via ${GW:-none}"
