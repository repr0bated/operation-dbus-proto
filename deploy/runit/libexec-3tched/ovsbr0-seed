#!/bin/sh
# Create the bridge and capture the physical uplink in ONE OVSDB transaction.
#
# Enslaving the uplink as a separate operation is the boot-time race: vswitchd
# reconfigures the datapath at the moment the host's only path to the network
# joins it, at a point nothing in runit orders. Creating the bridge with the
# uplink already in its ports set means vswitchd's first read of OVSDB sees the
# finished topology and brings the datapath up once.
#
# Designed to run from ovs-vswitchd/run BEFORE `exec ovs-vswitchd`, so there is
# no running datapath to disturb while the rows are replaced.
#
# NOTE (2026-08-13): nothing invokes this script today — ovs-vswitchd/run does
# not reference it and neither does the installer; setup-ovsbr0-atomic.sh is the
# live bridge-creation path. Kept in sync so it stays correct if revived.
set -eu
export PATH="/usr/local/bin:/usr/bin:/usr/sbin:${PATH:-}"
set -a; [ -r /etc/op-dbus/network.conf ] && . /etc/op-dbus/network.conf; set +a

BRIDGE="${BRIDGE:-ovsbr0}"
PHYS="${UPLINK_PHYS:-eth0}"
PUB="${PUBLIC_PORT:-pub0}"
FAIL_MODE="${FAIL_MODE:-standalone}"
DATAPATH="${DATAPATH_TYPE:-system}"

# OpenFlow versions the bridge accepts. Must be set here, because this script
# deletes and recreates the Bridge row — anything applied to the old row by hand
# does not carry over. op-of-controller speaks 1.5, while ovs-ofctl and other CLI
# clients may still default to 1.0 — allow both, or those clients fail version
# negotiation and vswitchd drops the socket, which surfaces at the caller as the
# misleading "failed to connect to socket (Broken pipe)". Leaving the column
# empty is not equivalent: OVS then defaults to OpenFlow10 alone and the
# controller cannot connect at all.
OF_PROTOCOLS="${OF_PROTOCOLS:-OpenFlow10,OpenFlow13,OpenFlow15}"

[ -d "/sys/class/net/$PHYS" ] || {
    echo "ovsbr0-seed: uplink $PHYS is absent — refusing to seed" >&2
    exit 1
}

# The provider filters on the uplink's MAC. Once eth0 is enslaved the kernel
# strips its addresses, and pub0 carries the public IP instead — so pub0 must
# present that same MAC. Pinned at creation via other_config:hwaddr rather than
# reset afterwards, so it is never briefly wrong.
MAC="$(cat "/sys/class/net/$PHYS/address")"

# Every OVSDB write below goes through zcall, so the plugin tree must answer.
/usr/local/libexec/3tched/wait-op-plugins 120

# Replace any bridge left in the persistent conf.db by the previous boot.
# Removing it from the root set garbage-collects its Ports and Interfaces, so
# the inserts below cannot collide with the unique index on `name`.
zcall ovsdb_bridge delete_bridge -a "{\"name\":\"$BRIDGE\"}" >/dev/null 2>&1 || true

# --- build the operation list -------------------------------------------------
# Every port rides in the same transact; the Bridge row references them all by
# named-uuid, so the bridge cannot exist without its uplink.
ops=""
refs=""

# Comma-separated OF_PROTOCOLS -> an OVSDB set literal.
protos=""
_oldifs="$IFS"
IFS=,
for _v in $OF_PROTOCOLS; do
    [ -n "$_v" ] && protos="${protos}\"${_v}\","
done
IFS="$_oldifs"
[ -n "$protos" ] || {
    echo "ovsbr0-seed: OF_PROTOCOLS is empty — refusing to seed" >&2
    exit 1
}
PROTOCOLS="[\"set\",[${protos%,}]]"

add_port() {
    _name="$1"; _type="$2"; _tag="$3"; _extra="${4:-}"
    ops="${ops}
{\"op\":\"insert\",\"table\":\"Interface\",\"uuid-name\":\"i_${_tag}\",
 \"row\":{\"name\":\"${_name}\",\"type\":\"${_type}\"${_extra}}},
{\"op\":\"insert\",\"table\":\"Port\",\"uuid-name\":\"p_${_tag}\",
 \"row\":{\"name\":\"${_name}\",\"interfaces\":[\"set\",[[\"named-uuid\",\"i_${_tag}\"]]]}},"
    refs="${refs}[\"named-uuid\",\"p_${_tag}\"],"
}

# The bridge's own internal port.
add_port "$BRIDGE" "internal" "br"
# Public port: carries the uplink MAC and, later, the public address.
add_port "$PUB" "internal" "pub" ",\"other_config\":[\"map\",[[\"hwaddr\",\"$MAC\"]]]"
n=0
for p in ${INTERNAL_PORTS:-3tched svc0}; do
    n=$((n + 1))
    [ "$p" = "$PUB" ] && continue
    add_port "$p" "internal" "int$n"
done
# The uplink itself — an ordinary system netdev, in the same transaction.
add_port "$PHYS" "system" "uplink"

PAYLOAD="{\"db_name\":\"Open_vSwitch\",\"operations\":[${ops}
{\"op\":\"insert\",\"table\":\"Bridge\",\"uuid-name\":\"br\",
 \"row\":{\"name\":\"${BRIDGE}\",\"datapath_type\":\"${DATAPATH}\",
          \"fail_mode\":\"${FAIL_MODE}\",
          \"protocols\":${PROTOCOLS},
          \"ports\":[\"set\",[${refs%,}]]}},
{\"op\":\"mutate\",\"table\":\"Open_vSwitch\",\"where\":[],
 \"mutations\":[[\"bridges\",\"insert\",[\"set\",[[\"named-uuid\",\"br\"]]]]]}]}"

zcall ovsdb_bridge transact -a "$PAYLOAD" >/dev/null

echo "ovsbr0-seed: $BRIDGE created with $PHYS enslaved in one transaction (pub=$PUB hwaddr=$MAC)"
