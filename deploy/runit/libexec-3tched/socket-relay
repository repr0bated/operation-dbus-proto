#!/usr/bin/env python3
"""Minimal byte relay replacing socat in runit units.

Modes:
  unix-listen <path> tcp-connect <host> <port>
  tcp-listen <bind_host> <port> unix-connect <path>
  tcp-listen <bind_host> <port> tcp-connect <host> <port>
"""
from __future__ import annotations

import asyncio
import os
import sys
from pathlib import Path


async def pipe(reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
    try:
        while True:
            data = await reader.read(65536)
            if not data:
                break
            writer.write(data)
            await writer.drain()
    except Exception:
        pass
    finally:
        try:
            writer.close()
            await writer.wait_closed()
        except Exception:
            pass


async def handle(client_r, client_w, connect_coro):
    try:
        remote_r, remote_w = await connect_coro()
    except Exception as exc:
        print(f"socket-relay: connect failed: {exc}", file=sys.stderr)
        client_w.close()
        await client_w.wait_closed()
        return
    await asyncio.gather(pipe(client_r, remote_w), pipe(remote_r, client_w))


async def run_unix_listen(path: str, host: str, port: int) -> None:
    p = Path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    if p.exists():
        p.unlink()

    async def client_connected(reader, writer):
        await handle(reader, writer, lambda: asyncio.open_connection(host, port))

    server = await asyncio.start_unix_server(client_connected, path=path)
    os.chmod(path, 0o666)
    print(f"socket-relay: unix-listen {path} -> tcp {host}:{port}", flush=True)
    async with server:
        await server.serve_forever()


async def run_tcp_listen(bind_host: str, bind_port: int, kind: str, target_a: str, target_b: str | None) -> None:
    async def client_connected(reader, writer):
        if kind == "unix-connect":
            coro = lambda: asyncio.open_unix_connection(target_a)
        else:
            coro = lambda: asyncio.open_connection(target_a, int(target_b))
        await handle(reader, writer, coro)

    server = await asyncio.start_server(client_connected, host=bind_host, port=bind_port, reuse_address=True)
    print(f"socket-relay: tcp-listen {bind_host}:{bind_port} -> {kind} {target_a}{':' + target_b if target_b else ''}", flush=True)
    async with server:
        await server.serve_forever()


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print(__doc__, file=sys.stderr)
        return 2
    mode = argv[1]
    if mode == "unix-listen" and len(argv) == 6 and argv[3] == "tcp-connect":
        asyncio.run(run_unix_listen(argv[2], argv[4], int(argv[5])))
        return 0
    if mode == "tcp-listen" and len(argv) >= 6:
        bind_host, bind_port = argv[2], int(argv[3])
        kind = argv[4]
        if kind == "unix-connect" and len(argv) == 6:
            asyncio.run(run_tcp_listen(bind_host, bind_port, kind, argv[5], None))
            return 0
        if kind == "tcp-connect" and len(argv) == 7:
            asyncio.run(run_tcp_listen(bind_host, bind_port, kind, argv[5], argv[6]))
            return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
