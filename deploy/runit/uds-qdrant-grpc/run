#!/bin/sh
# NIC-less publication: host TCP -> ghostbridge UDS -> container loopback.
# Replaces the Incus proxy device that used to bind 10.200.0.2:6334. Same listen
# address, so consumers are unaffected; only the mechanism changed.
exec 2>&1
until [ -S "/run/ghostbridge/qdrant/grpc.sock" ]; do
    echo "uds-qdrant-grpc: waiting for CT socket /run/ghostbridge/qdrant/grpc.sock"
    sleep 1
done
/usr/local/libexec/3tched/runit-ready-signal uds-qdrant-grpc 2>/dev/null || true
exec /usr/local/libexec/3tched/op-uds-relay --tcp-to-unix "10.200.0.2:6334=/run/ghostbridge/qdrant/grpc.sock"
