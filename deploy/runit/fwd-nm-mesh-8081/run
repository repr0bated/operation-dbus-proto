#!/bin/sh
exec 2>&1
# Netmaker API on mesh IP 100.69.0.1 — reachable by peers without svc0 egress.
until ss -lnt | grep -q "127.0.0.1:8081"; do sleep 1; done
until ip -4 addr show netmaker 2>/dev/null | grep -q "100.69.0.1/"; do sleep 1; done
/usr/local/libexec/3tched/runit-ready-signal fwd-nm-mesh-8081 2>/dev/null || true
exec /usr/local/libexec/3tched/socket-relay tcp-listen 100.69.0.1 8081 tcp-connect 127.0.0.1 8081
