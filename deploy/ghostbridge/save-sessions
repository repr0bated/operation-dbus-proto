#!/bin/bash
# Save sessions to disk on shutdown/reboot
# Called by: ExecStop in ghostbridge-session@.service

SESSIONS_DIR="/var/lib/ghostbridge/sessions"
BACKUP_DIR="/var/lib/ghostbridge/backups"

mkdir -p "$BACKUP_DIR"

echo "$(date): Saving sessions to disk..."

# Copy current in-memory state (if op-dbus exposes it) or just snapshot the dir
if [ -d "$SESSIONS_DIR" ]; then
    BACKUP_FILE="$BACKUP_DIR/sessions-$(date +%Y%m%d-%H%M%S).tar.gz"
    tar -czf "$BACKUP_FILE" -C "$SESSIONS_DIR" . 2>/dev/null || true
    
    # Keep only last 5 backups
    ls -t "$BACKUP_DIR"/sessions-*.tar.gz 2>/dev/null | tail -n +6 | xargs rm -f 2>/dev/null || true
    
    echo "$(date): Sessions saved to $BACKUP_FILE"
fi

# Also save any btrfs snapshot if available
if btrfs subvolume show "$SESSIONS_DIR" &>/dev/null; then
    SNAP_NAME="sessions-$(date +%Y%m%d-%H%M%S)"
    btrfs subvolume snapshot -r "$SESSIONS_DIR" "$BACKUP_DIR/$SNAP_NAME" 2>/dev/null || true
    echo "$(date): Btrfs snapshot created: $SNAP_NAME"
fi

echo "$(date): Session save complete"
