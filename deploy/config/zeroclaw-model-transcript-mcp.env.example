# ZeroClaw-owned NotebookLM MCP instance for model transcript research.
# This is intentionally a separate NotebookLM MCP profile/server name so its
# tools can be exposed without colliding with the default NotebookLM bridge.

COGNITIVE_MCP_NOTEBOOKLM_ENABLED=1
COGNITIVE_MCP_NOTEBOOKLM_COMMAND=npx
COGNITIVE_MCP_NOTEBOOKLM_ARGS=-y notebooklm-mcp@latest
COGNITIVE_MCP_NOTEBOOKLM_SERVER_NAME=zeroclaw-model-transcripts
COGNITIVE_MCP_NOTEBOOKLM_PROFILE=model-transcripts
COGNITIVE_MCP_NOTEBOOKLM_TOOL_PREFIX=zeroclaw_model_transcript

ZEROCLAW_MODEL_TRANSCRIPT_SOURCE_DIR=/run/op-dbus/zeroclaw/notebooklm-sources.d
ZEROCLAW_MODEL_TRANSCRIPT_DRIVE_ROOT=gdrive:NotebookLM/op-dbus/model-transcripts
