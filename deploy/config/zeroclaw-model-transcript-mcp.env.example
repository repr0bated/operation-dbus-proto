# Optional internal naming adapter for the single runit-owned NotebookLM MCP
# provider. It never spawns npx and never creates another listener/profile.

COGNITIVE_MCP_NOTEBOOKLM_ENABLED=1
COGNITIVE_MCP_NOTEBOOKLM_URL=http://127.0.0.1:3101/mcp
COGNITIVE_MCP_NOTEBOOKLM_SERVER_NAME=zeroclaw-model-transcripts
COGNITIVE_MCP_NOTEBOOKLM_TOOL_PREFIX=zeroclaw_model_transcript

ZEROCLAW_MODEL_TRANSCRIPT_SOURCE_DIR=/run/op-dbus/zeroclaw/notebooklm-sources.d
ZEROCLAW_MODEL_TRANSCRIPT_DRIVE_ROOT=gdrive:NotebookLM/op-dbus/model-transcripts
