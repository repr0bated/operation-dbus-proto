# Canonical NetMaker MQTT/WebSocket door shared by runit and deployment tools.
# :8090 is intentional: `/mqtt`, gRPC-Web, and native gRPC share one host port.
NETMAKER_BROKER_PORT=8090
NETMAKER_BROKER_PATH=/mqtt
NETMAKER_BROKER_SOCKET=/run/ghostbridge/NetMaker/broker.sock
NETMAKER_MESH_IP=100.69.0.1
