# Zeroclaw GUI headless Wayland runtime.
#
# Keep this isolated from CRD/X11. Do not set DISPLAY here.

OP_ZEROCLAW_USER=jeremy
OP_ZEROCLAW_GROUP=jeremy
ZEROCLAW_WAYLAND_DISPLAY=zeroclaw-wayland
ZEROCLAW_GUI_BIN=/usr/local/bin/zeroclaw-gui

# wayvnc is loopback-only by default. Reach it with SSH/WireGuard tunneling.
ZEROCLAW_WAYVNC_HOST=127.0.0.1
ZEROCLAW_WAYVNC_PORT=5901
ZEROCLAW_WAYVNC_EXTRA_ARGS=

# Set to 1 to force software rendering for machines without a usable headless EGL path.
ZEROCLAW_SOFTWARE_RENDER=0
