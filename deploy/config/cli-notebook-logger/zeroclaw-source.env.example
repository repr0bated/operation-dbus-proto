# This file is a single source declaration. ZeroClaw should emit one file like
# this per discovered CLI/model/session source into:
# /run/op-dbus/zeroclaw/notebooklm-sources.d/<client-model>.env
#
# The sync service discovers new files automatically. Do not hand-maintain
# client path lists in the service.

OP_CLI_TYPE=zeroclaw
OP_CLI_NAME=client-name-from-zeroclaw
OP_CLI_MODEL=provider/model-from-zeroclaw
OP_NOTEBOOK_ID=notebooklm-notebook-id-for-this-client-model
OP_GOOGLE_DRIVE_LOG_FILE=gdrive:NotebookLM/op-dbus/client-model.md
OP_SESSION_GLOB=/path/projected/by/zeroclaw/*
