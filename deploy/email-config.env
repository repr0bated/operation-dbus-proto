# Email configuration for magic links using the Maddy mail server
# From MAIL-SERVER-FINAL-CONFIG.md

# Mail Server (Maddy in crd-astral container)
export SMTP_HOST="10.149.181.121"
export SMTP_PORT="587"
export SMTP_USER="admin@3tched.com"
export SMTP_PASS="admin123"
export SMTP_FROM_EMAIL="noreply@3tched.com"
export SMTP_FROM_NAME="Operation DBUS Registration"

# Base URL for magic links
export BASE_URL="https://registration.3tched.com"

echo "✅ Email configuration loaded for magic links"
echo "📧 Using: $SMTP_USER@$SMTP_HOST:$SMTP_PORT"
echo "🔗 Magic links will use: $BASE_URL"
