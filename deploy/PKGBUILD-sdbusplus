# Maintainer: taotieren <admin@taotieren.com>
# S6/Artix wrapper — replaces systemd-libs with elogind (drop-in sd-bus provider)

pkgname=sdbusplus-git
pkgver=r911.1066415
pkgrel=1
pkgdesc="C++ bindings for systemd dbus APIs (Artix/s6 wrapper — elogind instead of systemd-libs)"
url="https://github.com/openbmc/sdbusplus"
arch=($CARCH)
license=('Apache-2.0')
depends=(
    "sh"
    "glibc"
    "libgcc"
    "libstdc++"
    "nlohmann-json"
    "python"
    "python-inflection"
    "python-jsonschema"
    "python-mako"
    "python-yaml"
    "elogind"          # <-- replaces systemd-libs; provides libelogind + sd-bus/sd-event/sd-daemon headers
    # AUR
    stdexec
)
makedepends=(
    "boost"
    "boost-libs"
    "cmake"
    "git"
    "gtest"
    "meson"
    "ninja"
    "pkgconf"
    "python-build"
    "python-installer"
    "python-setuptools"
    "python-wheel"
)
source=("${pkgname}::git+https://github.com/openbmc/sdbusplus.git")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${pkgname}"
    (
        set -o pipefail
        git describe --long --tag --abbrev=7 2>/dev/null | sed 's/^v//g;s/\([^-]*-g\)/r\1/;s/-/./g' ||
            printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
    )
}

build() {
    # Patch meson.build to use libelogind instead of libsystemd.
    # elogind on Artix provides the full sd-bus/sd-event/sd-daemon headers
    # under /usr/include/elogind/systemd/ and exports all sd_bus_* symbols
    # in libelogind.so (verified via nm -D).
    sed -i "s/dependency('libsystemd')/dependency('libelogind')/g" \
        "${srcdir}/${pkgname}/meson.build"

    arch-meson "${srcdir}/${pkgname}" build \
        -Dtests=disabled \
        -Dexamples=disabled
    meson compile -C build

    # Python tools
    cd "${srcdir}/${pkgname}/tools"
    python -m build --wheel --no-isolation
}

package() {
    meson install -C build --destdir "$pkgdir"
    cd "${srcdir}/${pkgname}/tools"
    python -m installer --destdir="$pkgdir" dist/*.whl
}
