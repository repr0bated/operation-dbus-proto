# ovsbr0 carries the host L3 configuration.
# OVS owns bridge switching, port membership, MAC, and fail_mode.
[Match]
Name=ovsbr0

[Link]
ActivationPolicy=up

[Network]
DHCP=no
LinkLocalAddressing=no
IPv6AcceptRA=no
ConfigureWithoutCarrier=yes
Address=148.113.204.83/32
DNS=1.1.1.1
DNS=8.8.8.8

[Route]
Gateway=148.113.204.1
GatewayOnLink=yes
Metric=100
