# ens3 is the physical uplink attached to ovsbr0 by persistent OVSDB state.
# Create a separate secondary interface (uplink1) as an ipvlan child so
# secondary routing stays independent from ovsbr0 while sharing ens3 L2.
[Match]
Name=ens3

[Link]
ActivationPolicy=up

[Network]
DHCP=no
LinkLocalAddressing=no
LLMNR=no
MulticastDNS=no
IPv6AcceptRA=no
IPVLAN=uplink1
