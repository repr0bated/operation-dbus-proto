# uplink1 carries a persistent secondary IPv4 uplink independent from ovsbr0.
[Match]
Name=uplink1

[Link]
ActivationPolicy=up

[Network]
DHCP=no
LinkLocalAddressing=no
LLMNR=no
MulticastDNS=no
IPv6AcceptRA=no
Address=15.235.37.41/32
DNS=1.1.1.1
DNS=8.8.8.8

[Route]
Destination=0.0.0.0/0
Gateway=148.113.204.1
GatewayOnLink=yes
Metric=4096

[Route]
Destination=0.0.0.0/0
Gateway=148.113.204.1
GatewayOnLink=yes
Table=200
Metric=100

[RoutingPolicyRule]
From=15.235.37.41/32
Priority=100
Table=200
