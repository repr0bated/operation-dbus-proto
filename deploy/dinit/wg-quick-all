# /etc/dinit.d/wg-quick-all
# Managed by deploy.sh — do not edit manually
# Brings up WireGuard tunnels before OVS attach-ports runs.
#   wgcf  — Cloudflare WARP egress tunnel (bridges into OVS)
#   wg0   — host VPN server for tablet/laptop/services-container clients
type = scripted
command = /usr/local/sbin/wg-quick-all-up.sh
stop-command = /usr/local/sbin/wg-quick-all-down.sh
