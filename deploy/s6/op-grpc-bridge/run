#!/bin/sh
# 🟢 🛷 The Shuttle — gRPC Bridge (zero-trust)
#
# Enforces the Absolute Base rule via GhostbridgeInterceptor.
# Reads IdentitySled from /dev/shm/plugin_schema.dat.
# Rejects all inbound requests until a valid sled is present.
# Xray redirects gRPC traffic to this endpoint.

set -eu
exec 2>&1

if [ -r /etc/op-dbus/environment ]; then
  set -a
  . /etc/op-dbus/environment
  set +a
fi

export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/op-dbus/session-bus.sock}"
export GRPC_BIND="${GRPC_BIND:-127.0.0.1:18789}"
export RUST_LOG="${RUST_LOG:-op_grpc_bridge=info,info}"

exec /usr/local/bin/op-grpc-bridge
