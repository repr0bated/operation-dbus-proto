#!/bin/sh
set -eu

BR="${BR:-ovsbr0}"
EXPECTED_DATAPATH="${PRIVACY_DATAPATH_TYPE:-netdev}"
EXPECTED_FAIL_MODE="${PRIVACY_FAIL_MODE:-standalone}"
OVSDB_SOCK="${OVSDB_SOCK:-/usr/local/var/run/openvswitch/db.sock}"

check_socket() {
    [ -S "$OVSDB_SOCK" ] || {
        echo "ovsbr0-netdev-verify: missing OVSDB socket $OVSDB_SOCK" >&2
        exit 1
    }
}

check_bridge() {
    dt="$(ovs-vsctl get bridge "$BR" datapath_type 2>/dev/null || echo missing)"
    fm="$(ovs-vsctl get bridge "$BR" fail_mode 2>/dev/null || echo missing)"

    if [ "$dt" != "$EXPECTED_DATAPATH" ]; then
        echo "ovsbr0-netdev-verify: $BR datapath_type=$dt expected $EXPECTED_DATAPATH" >&2
        ovs-vsctl show >&2 || true
        exit 1
    fi

    if [ "$fm" != "$EXPECTED_FAIL_MODE" ]; then
        echo "ovsbr0-netdev-verify: $BR fail_mode=$fm expected $EXPECTED_FAIL_MODE" >&2
        ovs-vsctl show >&2 || true
        exit 1
    fi

    echo "ovsbr0-netdev-verify: $BR datapath_type=$dt fail_mode=$fm"
}

check_socket
check_bridge
