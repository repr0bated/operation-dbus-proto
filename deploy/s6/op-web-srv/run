#!/bin/sh
# op-web-server — unified HTTP API + static UI (dev) for op-dbus
export PORT="${PORT:-8080}"
[ -r /etc/op-dbus/environment ] && . /etc/op-dbus/environment
export DBUS_SESSION_BUS_ADDRESS
: "${DBUS_SESSION_BUS_ADDRESS:?DBUS_SESSION_BUS_ADDRESS must be set in /etc/op-dbus/environment}"
export OP_DBUS_GRPC_ADDR="${OP_DBUS_GRPC_ADDR:-http://10.200.0.2:8090}"
export OP_DBUS_ADDR="${OP_DBUS_ADDR:-$OP_DBUS_GRPC_ADDR}"
export OP_MEMORY_DB="${OP_MEMORY_DB:-/var/lib/op-dbus/cognitive.db}"
# The control-plane UI is served by the assistant container.  Keep op-web as
# the authenticated REST/gRPC-Web gateway only; an explicit override can still
# attach a static tree for local development.
export OP_WEB_STATIC_DIR="${OP_WEB_STATIC_DIR-}"
export RUST_LOG="${RUST_LOG:-op_web=info,info}"

# Decoy ingress alias (10.0.0.2) + mesh grpc-uplink alias (10.200.0.2)
. /usr/local/lib/ghostbridge/bind-hub-aliases.sh

exec s6-setuidgid jeremy /usr/local/bin/op-web-server
