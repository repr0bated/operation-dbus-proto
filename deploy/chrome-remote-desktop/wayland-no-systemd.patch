+  def _fetch_wayland_socket_from_runtime_dir(self):
+    """
+    Fallback for hosts with no systemd user manager (this box runs runit).
+
+    On systemd hosts the compositor exports WAYLAND_DISPLAY into the systemd
+    user environment and the method above reads it back. With no such manager
+    there is nothing to read from, so find the socket the compositor actually
+    created in XDG_RUNTIME_DIR instead. Newest wins, so a stale socket from a
+    previous session does not shadow the live one.
+    """
+    runtime_dir = self.child_env.get("XDG_RUNTIME_DIR")
+    if not runtime_dir or not os.path.isdir(runtime_dir):
+      return False
+    candidates = []
+    for name in os.listdir(runtime_dir):
+      if not name.startswith("wayland-") or name.endswith(".lock"):
+        continue
+      try:
+        candidates.append(
+            (os.path.getmtime(os.path.join(runtime_dir, name)), name))
+      except OSError:
+        continue
+    if not candidates:
+      return False
+    candidates.sort()
+    self._wayland_socket = candidates[-1][1]
+    self.child_env["WAYLAND_DISPLAY"] = self._wayland_socket
+    logging.info("Found Wayland socket in XDG_RUNTIME_DIR: %s"
+                 % self._wayland_socket)
+    return True
+
+  def _systemd_user_available(self):
+    """True only if a systemd user manager is actually reachable."""
+    if not shutil.which("systemctl"):
+      return False
+    return subprocess.call(["systemctl", "--user", "show",
+                            "--property=Version"],
+                           stdout=subprocess.DEVNULL,
+                           stderr=subprocess.DEVNULL,
+                           env=self.child_env) == 0
+
+  def _start_portals_directly(self):
+    """
+    Start the portal services without `systemctl --user`.
+
+    xdg-desktop-portal and its backend are normally D-Bus-activated by the
+    systemd user manager. With no such manager they are launched here with the
+    session's environment, so the host can reach the ScreenCast and
+    RemoteDesktop portal APIs. For KDE these are required, not optional.
+    """
+    # get_portal_services() returns systemd unit names; the KDE backend's unit
+    # is "plasma-xdg-desktop-portal-kde" while the installed binary is
+    # xdg-desktop-portal-kde.
+    binaries = ["/usr/lib/xdg-desktop-portal"]
+    for service in self._wayland_session.get_portal_services():
+      binaries.append("/usr/lib/" + service.replace("plasma-", "", 1))
+    for binary in binaries:
+      if not os.path.exists(binary):
+        logging.error("Portal binary not found, portals will be unavailable: "
+                      "%s" % binary)
+        continue
+      logging.info("Starting portal service directly: %s" % binary)
+      subprocess.Popen([binary], env=self.child_env,
+                       stdout=subprocess.DEVNULL,
+                       stderr=subprocess.STDOUT)
+
