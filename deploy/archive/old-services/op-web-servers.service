[Unit]
Description=op-web Servers Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/op-dbus

# Environment
Environment="PORT=8084"
Environment="STATIC_DIR=/root/op-dbus/static"
Environment="RUST_LOG=info"
EnvironmentFile=/home/jeremy/.op-web.env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/op-dbus
CapabilityBoundingSet=

# Process limits
LimitNOFILE=65536
LimitNPROC=512

# Start service
ExecStart=/usr/local/sbin/op-web-server

# Restart policy
Restart=always
RestartSec=10s
StartLimitInterval=5min
StartLimitBurst=3

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=op-web-servers

[Install]
WantedBy=multi-user.target
