# Database and State
OP_DBUS_STATE_DIR=/var/lib/op-dbus

# Durable audit trail (event chain persisted to the streaming snowball's
# timing subvolume). Must be on Btrfs — op-grpc-bridge creates subvolumes here
# at startup and replays the trail back into the in-memory event chain, so the
# accountability history survives an `sv restart`. Commented out: the built-in
# default below is what the host already uses.
#OPDBUS_SNOWBALL_PATH=/var/lib/opdbus/snowball

# gRPC — consolidated op-grpc-bridge (HTTP/gRPC-Web + native gRPC)
# Prefer fabric-capable TCP endpoint first-class; loopback stays available via this env
# override for local-only debug.
OP_DBUS_GRPC_ADDR=https://10.0.0.3:8090
GRPC_BIND=0.0.0.0:8090
ZEROCLAW_BIND_ADDR=0.0.0.0:8090
# Host-local native gRPC (op-web, zbusctl)
ZEROCLAW_UNIX_SOCKET=/run/opdbus/grpc.sock
# Shared fabric for NIC-less containers (bind-mount /run/ghostbridge)
GHOSTBRIDGE_SOCKET_PATH=/run/ghostbridge/container.sock
# Root-owned append-only OIA replay journal. Every bridge ingress shares this
# file, so accepted nonces remain rejected after an op-grpc-bridge restart.
OP_AUTH_REPLAY_DB_PATH=/var/lib/op-dbus/auth-replay.db

# OpenFlow controller on ovsbr0
OPENFLOW_CONTROLLER=tcp:10.200.0.1:6653

# Email Configuration for Magic Links
SMTP_HOST=10.149.181.121
SMTP_PORT=587
SMTP_USER=noreply@3tched.com
SMTP_PASS=${SMTP_PASS_SECRET:-please_set_smtp_pass}
SMTP_FROM_EMAIL=noreply@3tched.com
SMTP_FROM_NAME="Operation DBUS Registration"

# Base URL for magic links (uses the reverse proxy we just set up)
BASE_URL=https://registration.3tched.com

# Trusted networks for WireGuard/authenticated access (comma-separated CIDRs/prefixes)
OP_TRUSTED_NETWORKS=10.0.0.0/24,10.200.0.0/24

# OpenClaw Gateway Configuration
OPENCLAW_TOKEN=your-openclaw-api-token-here
OPENCLAW_BASE_URL=http://10.0.0.1:8090
OPENCLAW_DEFAULT_MODEL=openclaw:main
