#!/sbin/openrc-run

name="op-mail-admin"
description="Private Postfix/Dovecot D-Bus administration owner"
command="/usr/local/bin/op-mail-admin"
pidfile="/run/op-mail-admin.pid"
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=5
respawn_period=1800

depend() {
    need localmount
    before postfix dovecot
}

start_pre() {
    case ${OP_MAIL_VMAIL_UID:-} in
        ''|*[!0-9]*|0) eerror "OP_MAIL_VMAIL_UID must be a nonzero numeric target ID"; return 1 ;;
    esac
    case ${OP_MAIL_VMAIL_GID:-} in
        ''|*[!0-9]*|0) eerror "OP_MAIL_VMAIL_GID must be a nonzero numeric target ID"; return 1 ;;
    esac
    case ${OP_MAIL_DOVECOT_GID:-} in
        ''|*[!0-9]*|0) eerror "OP_MAIL_DOVECOT_GID must be a nonzero numeric target ID"; return 1 ;;
    esac
    export OP_MAIL_VMAIL_UID OP_MAIL_VMAIL_GID OP_MAIL_DOVECOT_GID
    if ! mountpoint -q /opt/run-mounts/ghostbridge; then
        eerror "/opt/run-mounts/ghostbridge must be the Incus-mounted bridge directory"
        return 1
    fi
    if [ ! -d /opt/run-mounts/ghostbridge/mail ] ||
       [ "$(stat -c %u /opt/run-mounts/ghostbridge/mail)" -ne 0 ]; then
        eerror "/opt/run-mounts/ghostbridge/mail must be owned by container root"
        return 1
    fi
}
