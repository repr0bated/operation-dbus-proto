#!/bin/bash
# busctl-opdbus - Filtered busctl showing only op-dbus managed services
# Excludes: NetworkManager, systemd1, wpa_supplicant, and other external freedesktop services

# Patterns to exclude - ONLY the specific services you mentioned
EXCLUDE_SERVICES='org\.freedesktop\.(NetworkManager|systemd1?)|fi\.w1\.wpa_supplicant1'

# Run busctl and filter
busctl "$@" 2>&1 | awk -v exclude="$EXCLUDE_SERVICES" '
    BEGIN { in_service = 0; skip = 0; }
    
    # Service header line
    /^Service / {
        in_service = 1;
        skip = 0;
        if (match($0, exclude)) {
            skip = 1;
        }
    }
    
    # Print if not skipping
    !skip { print }
    
    # Reset when we see a blank line or new service
    /^$/ { in_service = 0; skip = 0; }
'
