#!/usr/bin/env bash
# notebook-sync — uv-managed cognitive notebook create/ingest
set -euo pipefail
# Prefer repo checkout; fall back to fixed host path
if [[ -n "${OP_DBUS_ROOT:-}" && -d "${OP_DBUS_ROOT}/scripts/uv-tools" ]]; then
  ROOT="$OP_DBUS_ROOT"
elif [[ -d /home/admin/git/odbus/scripts/uv-tools ]]; then
  ROOT=/home/admin/git/odbus
else
  ROOT="$(cd "$(dirname "$0")/.." && pwd)"
fi
PROJ="$ROOT/scripts/uv-tools"
exec uv run --project "$PROJ" python "$PROJ/notebook_sync.py" "$@"
