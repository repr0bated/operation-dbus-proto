#!/bin/sh
# notebook-sources-sync-up — one cycle: export → cleanup → notebook ingest
set -eu

export HOME="${HOME:-/home/jeremy}"
export USER="${USER:-jeremy}"
export PATH="${HOME}/.local/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/bin:/bin"
OP_DBUS_ROOT="${OP_DBUS_ROOT:-/srv/git/odbus}"
if [ ! -d "$OP_DBUS_ROOT/scripts" ]; then
    OP_DBUS_ROOT=/home/admin/git/odbus
fi
export OP_DBUS_ROOT
export NOTEBOOKLM_SOURCES_DIR="${NOTEBOOKLM_SOURCES_DIR:-/home/jeremy/.notebooklm-sources}"

# Load notebook.env safely (supports quoted values)
if [ -r "${NOTEBOOKLM_SOURCES_DIR}/notebook.env" ]; then
    set -a
    # shellcheck disable=SC1090
    . "${NOTEBOOKLM_SOURCES_DIR}/notebook.env"
    set +a
fi
# Per-model capture reads native logs and raw conversation DB rows directly.
# Do not run the old formatted-export/archive pipeline in this mode.
if [ "${OPDBUS_NOTEBOOK_SYNC_MODE:-}" = "per-model" ]; then
    exec "$OP_DBUS_ROOT/scripts/notebook-sync" ingest
fi
if [ -r /etc/op-dbus/environment ]; then
    # only pull notebook-related keys (avoid clobbering with bad lines)
    OP_NOTEBOOK_ID=$(grep -E '^OP_NOTEBOOK_ID=' /etc/op-dbus/environment 2>/dev/null | tail -1 | cut -d= -f2- || true)
    export OP_NOTEBOOK_ID
fi

log() { echo "notebook-sources-sync: $*"; }

log "export (incremental)"
EXPORTER="$OP_DBUS_ROOT/scripts/export-llm-sessions-to-notebooklm-sources.py"
if [ -f "$EXPORTER" ]; then
    python3 "$EXPORTER" 2>&1 || log "export failed"
elif [ -x "${HOME}/.local/bin/export-sessions-by-model.py" ]; then
    python3 "${HOME}/.local/bin/export-sessions-by-model.py" 2>&1 || log "export failed (continuing)"
else
    log "export script missing — skip"
fi

log "cleanup (append bundles ≤300, 195MiB rotate)"
if command -v notebook-sources-cleanup >/dev/null 2>&1; then
    notebook-sources-cleanup --archive-sessions 2>&1 || log "cleanup failed (continuing)"
elif [ -f "$OP_DBUS_ROOT/scripts/notebook-sources-cleanup.py" ]; then
    python3 "$OP_DBUS_ROOT/scripts/notebook-sources-cleanup.py" --archive-sessions 2>&1 || true
fi

TITLE="${NOTEBOOK_TITLE:-3tched LLM Sessions / Control Plane}"
# strip quotes if present
TITLE=$(printf '%s' "$TITLE" | sed "s/^'//;s/'$//")

SYNC="$OP_DBUS_ROOT/scripts/notebook-sync"
if [ -n "${OP_NOTEBOOK_ID:-}" ] || [ -n "${OP_NOTEBOOK_SOURCE_KEY:-}" ]; then
    if [ -x "$SYNC" ]; then
        log "ingest notebook title=${TITLE}"
        "$SYNC" ingest --title "$TITLE" 2>&1 || log "ingest failed"
    elif command -v notebook-sync >/dev/null 2>&1; then
        log "ingest notebook title=${TITLE}"
        notebook-sync ingest --title "$TITLE" 2>&1 || log "ingest failed"
    else
        log "notebook-sync missing — skip ingest"
    fi
else
    log "no notebook id — skip ingest (run: notebook-sync create)"
fi

log "cycle done"
