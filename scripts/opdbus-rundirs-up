    {
      "tag": "to-api",
      "protocol": "freedom",
      "settings": {
        "redirect": "10.200.0.2:8081"
      }
    },
    {
      "tag": "to-dashboard",
      "protocol": "freedom",
      "settings": {
        "redirect": "10.200.0.2:8080"
      }
    },
