      },
      {
        "type": "field",
        "inboundTag": [
          "xhttp-in"
        ],
        "domain": [
          "assistant-grpc.3tched.com"
        ],
        "outboundTag": "to-assistant-grpc"
      },
      {
        "type": "field",
        "inboundTag": [
          "xhttp-in"
        ],
        "domain": [
          "broker.ghostbridge.tech"
        ],
        "outboundTag": "to-broker"
      },
      {
        "type": "field",
        "inboundTag": [
          "xhttp-in"
        ],
        "domain": [
          "broker.3tched.com"
        ],
        "outboundTag": "to-broker"
      },
      {
        "type": "field",
        "inboundTag": [
          "xhttp-in"
        ],
        "outboundTag": "block"
      }
    ]
  }
}

XRAY
if id xray >/dev/null 2>&1; then
    chown root:xray /dev/shm/xray_config.json
    chmod 0640 /dev/shm/xray_config.json
else
    chmod 0644 /dev/shm/xray_config.json
fi
# Also publish into the disk mount shared with the xray CT. /dev/shm file binds
# are hidden when systemd remounts /dev/shm as tmpfs inside the container.
install -d -m 0755 /var/lib/opdbus-runtime
cp -a /dev/shm/xray_config.json /var/lib/opdbus-runtime/xray_config.json
chmod 0644 /var/lib/opdbus-runtime/xray_config.json
echo "rundirs ready: /run/opdbus, SHM catalog, xray bootstrap (10.0.0.2 + 10.200.0.1)"
