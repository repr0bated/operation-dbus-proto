      "settings": {
        "address": "10.200.0.2",
        "port": 8091,
        "network": "tcp"
      }
    },
    {
      "tag": "xhttp-in",
      "listen": "10.200.0.1",
      "port": 8444,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "5567b57e-e95c-462c-8fc2-61414eddc02b",
            "level": 0
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "xhttpSettings": {
          "path": "/xhttp",
