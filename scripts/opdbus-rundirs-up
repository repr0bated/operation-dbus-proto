#!/bin/sh
# opdbus-rundirs: runtime dirs + sealed-blob SHM catalog + xray SHM bootstrap.
set -eu
install -d -m 0755 /run/opdbus
# Shared container UDS parent (bind-mounted into assistant/qdrant as /run/ghostbridge)
install -d -m 0755 /run/ghostbridge
install -d -m 0755 /run/op-dbus
install -d -m 0755 /run/opdbus/runit-ready
install -d -m 0755 /dev/shm/opdbus/plugin-blobs
# socket rendezvous parents shared into NIC-less containers (socket contracts)
install -d -m 0755 /var/lib/opdbus-runtime /var/lib/netmaker-runtime
install -d -m 0755 -o svlog -g svlog /var/log/op-dbus
# Seal the plugin blobs BEFORE op-grpc-bridge starts: the bridge hydrates its
# gRPC reflection from this catalog and retry-loops against an empty tmpfs.
if [ -x /usr/local/bin/opblob ]; then
    /usr/local/bin/opblob seal-shm >/dev/null
else
    echo "warning: /usr/local/bin/opblob missing — blob catalog not sealed"
fi
# Host Identity Sled — required by op-web's gRPC client (attach_ghostbridge_metadata)
# and by GhostbridgeInterceptor on StateSync/EventChain. Lives in tmpfs; re-seed every boot.
if [ -x /usr/local/bin/op-identity-sled ]; then
    WG_IFACE="${OP_IDENTITY_WG_IFACE:-3tched}"
    PUBKEY=""
    if command -v wg >/dev/null 2>&1; then
        PUBKEY=$(wg show "$WG_IFACE" public-key 2>/dev/null || true)
    fi
    if [ -n "$PUBKEY" ]; then
        /usr/local/bin/op-identity-sled --refresh --pubkey "$PUBKEY" >/dev/null 2>&1 \
            && echo "identity sled seeded from $WG_IFACE" \
            || echo "warning: op-identity-sled --refresh failed"
    else
        echo "warning: no WG pubkey for $WG_IFACE — identity sled not seeded"
    fi
else
    echo "warning: /usr/local/bin/op-identity-sled missing — identity sled not seeded"
fi
# Static xray bootstrap lives ONLY in SHM (hard invariant). Listens on
# 10.0.0.2 (netmaker egress path) — never the public uplink. The model's
# dynamic tag routing replaces this file atomically later; XHTTP shape
# arrives with it (not speced yet).
cat > /dev/shm/xray_config.json <<'XRAY'
{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "egress-proxy",
      "listen": "0.0.0.0",
      "port": 10809,
      "protocol": "http",
      "settings": {}
    },
    {
      "tag": "grpc-uplink",
