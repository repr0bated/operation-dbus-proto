        "network": "tcp"
      }
    },
    {
      "tag": "qdrant-http",
      "listen": "10.200.0.1",
      "port": 6333,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "10.200.0.2",
        "port": 6333,
        "network": "tcp"
      }
    },
    {
      "tag": "assistant-ui",
      "listen": "10.200.0.1",
      "port": 8091,
