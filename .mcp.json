{
  "mcpServers": {
    "op-web-compact": {
      "command": "/usr/local/bin/op-mcp-server",
      "args": [
        "--stdio",
        "-m",
        "cognitive"
      ],
      "type": "stdio"
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/admin/git/odbus"
      ],
      "type": "stdio"
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "type": "stdio"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "type": "stdio"
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "type": "stdio"
    },
    "op-dbus-compact": {
      "url": "http://127.0.0.1:8080/mcp/compact",
      "type": "http"
    },
    "op-dbus-agents": {
      "url": "http://127.0.0.1:8080/mcp/agents/message",
      "type": "http"
    }
  }
}
