{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/admin/git/odbus"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-fetch"
      ],
      "enabled": true
    },
    "cognitive-mcp": {
      "type": "remote",
      "url": "http://10.200.0.2:3003/mcp",
      "enabled": true,
      "headers": {
        "X-Ghostbridge-Footprint": "mcp-client",
        "X-Ghostbridge-Trace-ID": "mcp-add-project"
      }
    },
    "op-dbus-compact": {
      "type": "remote",
      "url": "http://127.0.0.1:8080/mcp/compact",
      "enabled": true
    },
    "op-dbus-agents": {
      "type": "remote",
      "url": "http://127.0.0.1:8080/mcp/agents",
      "enabled": true
    },
    "op-cognitive-mcp": {
      "type": "local",
      "command": [
        "/usr/local/bin/op-cognitive-mcp",
        "--stdio"
      ],
      "enabled": true
    },
    "op-web-compact": {
      "type": "local",
      "command": [
        "/usr/local/bin/op-mcp-server",
        "--stdio",
        "-m",
        "compact"
      ],
      "enabled": true
    }
  }
}
