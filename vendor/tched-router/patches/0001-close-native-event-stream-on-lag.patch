+/// Convert the broadcast receiver into the live SSE stream.
+///
+/// A lag error means at least one frame was irretrievably skipped. Ending the
+/// response makes that loss observable to clients, which can subscribe again
+/// and rehydrate their authoritative snapshot. Continuing after the error
+/// would make the last delivered frame look current when it is not.
+fn live_event_stream(
+    rx: tokio::sync::broadcast::Receiver<serde_json::Value>,
+    auth_enforced: bool,
+) -> impl tokio_stream::Stream<Item = Result<Event, Infallible>> {
+    BroadcastStream::new(rx)
+        .take_while(Result::is_ok)
+        .filter_map(
