+//! One provider-only generation turn. Config owns provider/model selection;
+//! this consumed view pins that selection for one request. There is no Agent,
+//! memory, history, workspace, tool registry, provider fallback or persistence.
+use crate::{ModelProvider, ProviderDispatch};
+use futures_util::{
+    StreamExt,
+    stream::{self, BoxStream},
+};
+use zeroclaw_api::model_provider::{
+    ChatMessage, ChatRequest, StreamEvent, StreamOptions, TokenUsage,
+};
+
+pub const MAX_PROMPT_BYTES: usize = 64 * 1024;
+pub const MAX_OUTPUT_BYTES: usize = 256 * 1024;
+const MAX_EVENTS: usize = 4096;
+
+#[derive(Debug, Clone, Copy, thiserror::Error)]
+pub enum GenerationError {
+    #[error("stateless_generation_invalid_request")]
+    InvalidRequest,
+    #[error("stateless_generation_unavailable")]
+    Unavailable,
+    #[error("stateless_generation_provider_failed")]
+    Provider,
+    #[error("stateless_generation_protocol_failed")]
+    Protocol,
+    #[error("stateless_generation_bounds_exceeded")]
+    Bounds,
+}
+
+pub enum GenerationEvent {
+    Delta(String),
+    Done {
+        response: String,
+        usage: Option<TokenUsage>,
+    },
+}
+
+pub struct StatelessGeneration {
+    provider: Box<dyn ModelProvider>,
+    pub provider_ref: String,
+    pub model: String,
+}
+
+impl StatelessGeneration {
+    pub fn from_config(
+        config: &zeroclaw_config::schema::Config,
+        agent: &str,
+    ) -> Result<Self, GenerationError> {
+        if !config.agent(agent).is_some_and(|entry| entry.enabled) {
+            return Err(GenerationError::Unavailable);
+        }
+        let (family, alias, _) = config
+            .resolved_model_provider_for_agent(agent)
+            .ok_or(GenerationError::Unavailable)?;
+        let provider_ref = format!("{family}.{alias}");
+        let resolved = crate::create_model_provider_from_ref_with_model(config, &provider_ref)
+            .map_err(|_| GenerationError::Unavailable)?;
+        let model = resolved.model.ok_or(GenerationError::Unavailable)?;
+        if !resolved.provider.supports_stateless_generation()
+            || model.is_empty()
+            || model.len() > 256
+            || provider_ref.len() > 256
+            || model.chars().any(char::is_control)
+            || provider_ref.chars().any(char::is_control)
+        {
+            return Err(GenerationError::Unavailable);
+        }
+        Ok(Self {
+            provider: resolved.provider,
+            provider_ref,
+            model,
+        })
+    }
+
+    pub fn start(
+        self,
+        prompt: String,
+    ) -> Result<BoxStream<'static, Result<GenerationEvent, GenerationError>>, GenerationError> {
+        if prompt.trim().is_empty()
+            || prompt.len() > MAX_PROMPT_BYTES
+            || !self.provider.supports_stateless_generation()
+        {
+            return Err(GenerationError::InvalidRequest);
+        }
+        let events: BoxStream<'static, Result<StreamEvent, GenerationError>> =
+            if self.provider.supports_streaming() {
+                let messages = [ChatMessage::user(prompt)];
+                ProviderDispatch::from_ref(self.provider.as_ref())
+                    .stream_chat(
+                        ChatRequest {
+                            messages: &messages,
+                            tools: None,
+                            thinking: None,
+                        },
+                        &self.model,
+                        None,
+                        StreamOptions::new(true),
+                    )
+                    .map(|event| event.map_err(|_| GenerationError::Provider))
+                    .boxed()
+            } else {
+                // The native provider still owns the HTTP request. A unary-only
+                // implementation produces one final delta, without fabricated usage.
+                stream::once(async move {
+                    let messages = [ChatMessage::user(prompt)];
+                    let response = ProviderDispatch::from_ref(self.provider.as_ref())
+                        .chat(
+                            ChatRequest {
+                                messages: &messages,
+                                tools: None,
+                                thinking: None,
+                            },
+                            &self.model,
+                            None,
+                        )
+                        .await
+                        .map_err(|_| GenerationError::Provider)?;
+                    if !response.tool_calls.is_empty() {
+                        return Err(GenerationError::Protocol);
+                    }
+                    let mut events = Vec::new();
+                    if let Some(text) = response.text {
+                        events.push(Ok(StreamEvent::TextDelta(
+                            zeroclaw_api::model_provider::StreamChunk::delta(text),
+                        )));
+                    }
+                    if let Some(usage) = response.usage {
+                        events.push(Ok(StreamEvent::Usage(usage)));
+                    }
+                    events.push(Ok(StreamEvent::Final));
+                    Ok(stream::iter(events))
+                })
+                .try_flatten()
+                .boxed()
+            };
+        Ok(bound_stream(events))
+    }
+}
+
+use futures_util::TryStreamExt;
+
+fn bound_stream(
+    events: BoxStream<'static, Result<StreamEvent, GenerationError>>,
+) -> BoxStream<'static, Result<GenerationEvent, GenerationError>> {
+    stream::unfold(
+        (events, String::new(), None, 0usize, false),
+        |(mut events, mut response, mut usage, mut count, done)| async move {
+            if done {
+                return None;
+            }
+            loop {
+                count = count.saturating_add(1);
+                let event = if count > MAX_EVENTS {
+                    Err(GenerationError::Bounds)
+                } else {
+                    events
+                        .next()
+                        .await
+                        .unwrap_or(Err(GenerationError::Protocol))
+                };
+                match event {
+                    Ok(StreamEvent::TextDelta(chunk)) => {
+                        if response.len().saturating_add(chunk.delta.len()) > MAX_OUTPUT_BYTES {
+                            return Some((
+                                Err(GenerationError::Bounds),
+                                (events, response, usage, count, true),
+                            ));
+                        }
+                        if chunk.delta.is_empty() {
+                            continue;
+                        }
+                        response.push_str(&chunk.delta);
+                        return Some((
+                            Ok(GenerationEvent::Delta(chunk.delta)),
+                            (events, response, usage, count, false),
+                        ));
+                    }
+                    Ok(StreamEvent::Usage(observed)) => usage = Some(observed),
+                    Ok(StreamEvent::Final) => {
+                        return Some((
+                            Ok(GenerationEvent::Done { response, usage }),
+                            (events, String::new(), None, count, true),
+                        ));
+                    }
+                    Ok(
+                        StreamEvent::ToolCall(_)
+                        | StreamEvent::PreExecutedToolCall { .. }
+                        | StreamEvent::PreExecutedToolResult { .. },
+                    ) => {
+                        return Some((
+                            Err(GenerationError::Protocol),
+                            (events, response, usage, count, true),
+                        ));
+                    }
+                    Err(error) => {
+                        return Some((Err(error), (events, response, usage, count, true)));
+                    }
+                }
+            }
+        },
+    )
+    .boxed()
+}
