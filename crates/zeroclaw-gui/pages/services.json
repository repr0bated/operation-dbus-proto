{
  "title": "Services",
  "source": {
    "plugin": "s6_systemctl",
    "method": "list_units",
    "args": [],
    "poll_secs": 10
  },
  "data": {
    "daemon": { "status": "sample", "backend": "s6" },
    "units": [
      { "name": "op-grpc-bridge", "status": "up" },
      { "name": "op-projection", "status": "up" },
      { "name": "zeroclaw-wgui", "status": "warn" }
    ]
  },
  "spec": {
    "kind": "stack",
    "children": [
      { "kind": "heading", "text": "Services", "size": 18 },
      { "kind": "muted", "text": "s6 units from s6_systemctl.list_units." },
      { "kind": "space", "px": 12 },
      { "kind": "card", "children": [
        { "kind": "stack", "dir": "h", "children": [
          { "kind": "label", "text": "Daemon:" },
          { "kind": "status_pill", "bind": "/daemon/status" },
          { "kind": "space", "px": 12 },
          { "kind": "label", "bind": "/daemon/backend" }
        ]}
      ]},
      { "kind": "space", "px": 8 },
      { "kind": "card", "children": [
        { "kind": "heading", "text": "Units", "size": 13 },
        { "kind": "repeat", "bind": "/units", "child": {
          "kind": "stack", "dir": "h", "children": [
            { "kind": "label", "bind": "/name" },
            { "kind": "space", "px": 12 },
            { "kind": "status_pill", "bind": "/status" }
          ]
        }}
      ]}
    ]
  }
}
