{
  "title": "Privacy Network",
  "source": {
    "plugin": "wireguard",
    "method": "list_peers",
    "args": [],
    "poll_secs": 8
  },
  "data": {
    "interface": { "name": "wg0", "status": "sample" },
    "peers": [
      { "public_key": "abc…", "endpoint": "10.0.0.1:51820", "status": "ok" },
      { "public_key": "def…", "endpoint": "unset", "status": "warn" }
    ]
  },
  "spec": {
    "kind": "stack",
    "children": [
      { "kind": "heading", "text": "Privacy Network", "size": 18 },
      { "kind": "muted", "text": "WireGuard peers via wireguard.list_peers." },
      { "kind": "space", "px": 12 },
      { "kind": "card", "children": [
        { "kind": "stack", "dir": "h", "children": [
          { "kind": "label", "text": "Interface:" },
          { "kind": "label", "bind": "/interface/name" },
          { "kind": "space", "px": 12 },
          { "kind": "status_pill", "bind": "/interface/status" }
        ]}
      ]},
      { "kind": "space", "px": 8 },
      { "kind": "card", "children": [
        { "kind": "heading", "text": "Peers", "size": 13 },
        { "kind": "repeat", "bind": "/peers", "child": {
          "kind": "stack", "dir": "h", "children": [
            { "kind": "label", "bind": "/public_key" },
            { "kind": "space", "px": 8 },
            { "kind": "label", "bind": "/endpoint" },
            { "kind": "space", "px": 8 },
            { "kind": "status_pill", "bind": "/status" }
          ]
        }}
      ]}
    ]
  }
