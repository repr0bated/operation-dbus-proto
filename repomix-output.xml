#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct NetmakerNetwork {
    pub name: String,
    pub connected: bool,
    pub is_default: bool,
    pub node_id: Option<String>,
    pub peers: Vec<String>,
    pub address: Option<String>,
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct NetmakerState {
