            Ok(format!(
                "Files need formatting:\n{}\nstderr: {}",
                stdout, stderr
            ))
        }
    }

    fn go_vet(&self, path: Option<&str>) -> Result<String, String> {
        let mut cmd = Command::new("go");
        cmd.arg("vet");
        cmd.arg("./...");

