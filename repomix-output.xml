    }

    #[tokio::test]
    async fn test_discovery_system() {
        let system = ToolDiscoverySystem::new();

        let tools = vec![ToolDefinition {
            name: "builtin_tool".to_string(),
            description: "Built-in tool".to_string(),
            input_schema: simd_json::json!({}),
