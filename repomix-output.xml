        "Go Pro Agent"
    }

    fn description(&self) -> &str {
        "Go development environment with build, test, and analysis tools"
    }

    fn operations(&self) -> Vec<String> {
        vec![
            "build".to_string(),
            "test".to_string(),
            "fmt".to_string(),
            "vet".to_string(),
            "run".to_string(),
        ]
    }

    fn security_profile(&self) -> &SecurityProfile {
        &self.profile
    }

