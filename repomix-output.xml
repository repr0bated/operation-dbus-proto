            backend_checkpoint: None,
        })
    }

    async fn rollback(&self, _checkpoint: &op_state::Checkpoint) -> Result<()> {
        Err(anyhow::anyhow!("Privacy plugin rollback not implemented - individual component plugins handle their own rollback"))
    }
}
