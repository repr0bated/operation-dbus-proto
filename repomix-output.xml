        let mut cmd = Command::new("go");
        cmd.arg("test");
        cmd.arg("./...");
        cmd.arg("-v");

        if let Some(a) = args {
            validation::validate_args(a)?;
            for arg in a.split_whitespace() {
                cmd.arg(arg);
            }
        }

