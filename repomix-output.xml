                          )}
                        </CardContent>
                      </Card>
                    );
                  })
                ) : (
                  <p className="text-sm text-muted-foreground font-mono text-center py-8">
                    No models available
                  </p>
                )}
              </div>
            </div>
          </div>
        </ScrollArea>
      </div>
    </>
  );
}
