                            .unwrap_or("")
                            .to_string(),
                        is_admin: user_data
                            .as_object()
                            .and_then(|o| o.get("is_admin"))
                            .and_then(|v| v.as_bool())
                            .unwrap_or(false),
                        registered_at: None,
                        last_active: None,
                    }));
                }
            }
        }

        let args = simd_json::json!({
            "email": req.email,
            "user_id": req.user_id,
            "domain": req.domain
        });

        match self
            .registration_dbus_call("get_user_status", &args.to_string())
