        std::env::set_var("TEST_TOKEN", "secret123");
        assert_eq!(resolve_env_var("${TEST_TOKEN}"), "secret123");
        assert_eq!(resolve_env_var("plain_value"), "plain_value");
        std::env::remove_var("TEST_TOKEN");
    }

