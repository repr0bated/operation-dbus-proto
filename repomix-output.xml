    fn go_fmt(&self, path: Option<&str>) -> Result<String, String> {
        let mut cmd = Command::new("gofmt");
        cmd.arg("-l");

        if let Some(p) = path {
            let validated_path = validation::validate_path(p, ALLOWED_DIRS)?;
            cmd.arg(validated_path);
        } else {
            cmd.arg(".");
        }

