        assert!(matches!(mode, ExecutionMode::MultiAgent { .. }));

        // Test direct
        let mode = executor.determine_mode("ovs_list_bridges", &json!({})).await;
        assert!(matches!(mode, ExecutionMode::Direct { .. }));
    }
