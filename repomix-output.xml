    }

    fn input_schema(&self) -> Value {
        json!({
            "type": "object",
            "properties": {
                "service": { "type": "string" },
                "path": { "type": "string" },
                "interface": { "type": "string" },
                "method": { "type": "string" },
                "args": {
                    "type": "array",
                    "description": "Method arguments (as JSON values)"
                },
