mod tests {
    use super::*;

    #[tokio::test]
    async fn test_respond_to_user() {
        init_response_accumulator();
        let tool = RespondToUserTool::new();
        let result = tool
            .execute(json!({
                "message": "Bridge created successfully",
                "message_type": "success",
                "related_actions": ["ovs_create_bridge"]
            }))
            .await
            .unwrap();

        assert_eq!(
