                            <!-- Presets populated by JS -->
                        </div>
                    </div>
                    
                    <h4 style="margin-bottom: 0.5rem; font-size: 0.85rem; color: var(--text-secondary);">
                        Enabled Groups (<span id="sidebar-count">0</span>)
                    </h4>
