    fn inputs(&self) -> Vec<NodePort> {
        Vec::new()
    }

    fn outputs(&self) -> Vec<NodePort> {
        vec![
            NodePort::optional("logged", "Logged", "boolean"),
            NodePort::optional("message", "Message", "string"),
        ]
