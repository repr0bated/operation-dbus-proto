+#[tokio::test(flavor = "multi_thread")]
+async fn project_native_owner_covers_create_documents_context_and_isolation() -> anyhow::Result<()>
+{
+    let _cozo = temp_cozo();
+    let _shm = temp_shm_with_schemas(&[
+        op_plugins::state_plugins::human_principal::HumanPrincipalPlugin::new()
+            .schema()
+            .unwrap(),
+        op_plugins::state_plugins::identity_sled::IdentitySledPlugin::new()
+            .schema()
+            .unwrap(),
+        ProjectPlugin.schema().unwrap(),
+    ]);
+    let engine = test_engine();
+    engine.install_identity_sled_store_for_test(IdentitySledStore::new(
+        CozoGraphShuttle::new_in_memory()?,
+    ))?;
+    let grants_root = tempfile::tempdir()?;
+    let _grants_environment = GrantsEnvironment(std::env::var_os("OP_GRANTS_PATH"));
+    let grants_path = grants_root.path().join("capability-grants.json");
+    std::env::set_var("OP_GRANTS_PATH", &grants_path);
+    let owner = identity(&engine, 0xe7, "native-project-owner").await?;
+    let member = identity(&engine, 0xe8, "native-project-member").await?;
+    let capabilities = [
+        "project.create",
+        "project.read",
+        "project.write",
+        "chat.context",
+    ];
+    write_grants(
+        &grants_path,
+        &[
+            (&owner, &capabilities),
+            (&member, &["project.read", "project.write", "chat.context"]),
+        ],
+    );
+
+    let fixture = IncusFixture::new().await?;
+    let project_root = tempfile::tempdir()?;
+    let project_owner = ProjectOwner::fixture(
+        project_root.path().to_path_buf(),
+        fixture.socket.clone(),
+        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+        "fixture-pool",
+    );
+    let _owner_guard = install_project_owner_for_test(project_owner);
+
+    let agent = known_agent_ids()
+        .into_iter()
+        .next()
+        .context("agent catalog")?;
+    let ceiling = ["project.read", "project.write", "chat.context"];
+    let first = invoke(
+        &engine,
+        &owner,
+        "create",
+        json!({"title":"native fixture one","capability_ceiling":ceiling,"allowed_agents":[agent.clone()]}),
+    )
+    .await?;
+    let first_project = first["project"].clone();
+    let first_id = first_project["project_id"]
+        .as_str()
+        .context("first project id")?
+        .to_owned();
+    let first_path = first_project["persistence_path"]
+        .as_str()
+        .context("first persistence path")?;
+    assert_eq!(first_project["status"], "ready");
+    assert!(first_path.starts_with(project_root.path().to_str().unwrap()));
+    assert_eq!(first_project["owner_session_id"], owner.session_id);
+    assert_eq!(
+        std::fs::metadata(first_path)?.permissions().mode() & 0o777,
+        0o700
+    );
+
+    let memory = invoke(
+        &engine,
+        &owner,
+        "put_document",
+        json!({"project_id":first_id,"document_id":"memory-one","collection":"memory","content":"private memory","media_type":"text/plain"}),
+    )
+    .await?;
+    assert_eq!(memory["document"]["content"], "private memory");
+    assert_eq!(memory["document"]["author_session_id"], owner.session_id);
+    let artifact = invoke(
+        &engine,
+        &owner,
+        "put_document",
+        json!({"project_id":first_id,"document_id":"artifact-one","collection":"artifacts","content":"private artifact","media_type":"text/plain"}),
+    )
+    .await?;
+    assert_eq!(artifact["document"]["collection"], "artifacts");
+
+    let memory_rows = invoke(
+        &engine,
+        &owner,
+        "list_documents",
+        json!({"project_id":first_id,"collection":"memory"}),
+    )
+    .await?;
+    assert_eq!(memory_rows["documents"].as_array().unwrap().len(), 1);
+    assert_eq!(memory_rows["documents"][0]["document_id"], "memory-one");
+    assert_eq!(memory_rows["documents"][0]["content"], "private memory");
+    let artifact_rows = invoke(
+        &engine,
+        &owner,
+        "list_documents",
+        json!({"project_id":first_id,"collection":"artifacts"}),
+    )
+    .await?;
+    assert_eq!(artifact_rows["documents"].as_array().unwrap().len(), 1);
+    assert_eq!(artifact_rows["documents"][0]["document_id"], "artifact-one");
+    assert_eq!(artifact_rows["documents"][0]["content"], "private artifact");
+
+    let context = invoke(
+        &engine,
+        &owner,
+        "resolve_context",
+        json!({"mode":"project","project_id":first_id}),
+    )
+    .await?;
+    assert_eq!(context["project_id"], first_id);
+    assert_eq!(context["memory_namespace"], format!("project/{first_id}"));
+    assert_eq!(context["read_only"], false);
+    assert_eq!(context["allowed_agents"], json!([agent.clone()]));
+    assert_eq!(context["selected_agent"], Value::Null);
+    assert_eq!(
+        context["effective_capabilities"],
+        json!(["chat.context", "project.read", "project.write"]),
+    );
+
+    let second = invoke(
+        &engine,
+        &owner,
+        "create",
+        json!({"title":"native fixture two","capability_ceiling":ceiling,"allowed_agents":[]}),
+    )
+    .await?;
+    let second_id = second["project"]["project_id"]
+        .as_str()
+        .context("second project id")?;
+    let second_rows = invoke(
+        &engine,
+        &owner,
+        "list_documents",
+        json!({"project_id":second_id,"collection":"memory"}),
+    )
+    .await?;
+    assert_eq!(second_rows["documents"], json!([]));
+    let first_rows_again = invoke(
+        &engine,
+        &owner,
+        "list_documents",
+        json!({"project_id":first_id,"collection":"memory"}),
+    )
+    .await?;
+    assert_eq!(
+        first_rows_again["documents"][0]["document_id"],
+        "memory-one"
+    );
+
+    // A durable session that is not a member cannot reach the project owner or Cozo store.
+    let before_member = fixture.request_count();
+    assert!(invoke(
+        &engine,
+        &member,
+        "list_documents",
+        json!({"project_id":first_id,"collection":"memory"}),
+    )
+    .await
+    .is_err());
+    assert_eq!(fixture.request_count(), before_member);
+
+    // Exact grant removal fails before native verification or a Cozo write.
+    write_grants(
+        &grants_path,
+        &[
+            (&owner, &["project.read", "chat.context"]),
+            (&member, &["project.read"]),
+        ],
+    );
+    let before_grant = fixture.request_count();
+    assert!(invoke(
+        &engine,
+        &owner,
+        "put_document",
+        json!({"project_id":first_id,"document_id":"denied","collection":"memory","content":"denied","media_type":"text/plain"}),
+    )
+    .await
+    .is_err());
+    assert_eq!(fixture.request_count(), before_grant);
+
+    // Native readback mismatch blocks every project owner operation.
+    write_grants(
+        &grants_path,
+        &[
+            (&owner, &capabilities),
+            (&member, &["project.read", "project.write", "chat.context"]),
+        ],
+    );
+    fixture.bad_binding.store(true, Ordering::SeqCst);
+    for (method, args) in [
+        (
+            "put_document",
+            json!({"project_id":first_id,"document_id":"mismatch","collection":"memory","content":"x","media_type":"text/plain"}),
+        ),
+        (
+            "list_documents",
+            json!({"project_id":first_id,"collection":"memory"}),
+        ),
+        (
+            "resolve_context",
+            json!({"mode":"project","project_id":first_id}),
+        ),
+    ] {
+        assert!(
+            invoke(&engine, &owner, method, args).await.is_err(),
+            "{method} must reject mismatched owner binding"
+        );
+    }
+    fixture.bad_binding.store(false, Ordering::SeqCst);
+
+    // A provisioned Incus operation with failed owner readback remains Provisioning.
+    fixture.bad_binding.store(true, Ordering::SeqCst);
+    assert!(invoke(
+        &engine,
+        &owner,
+        "create",
+        json!({"title":"failed binding","capability_ceiling":ceiling,"allowed_agents":[]}),
+    )
+    .await
+    .is_err());
+    let failed_id = fixture
+        .project_ids
+        .lock()
+        .unwrap()
+        .last()
+        .cloned()
+        .context("failed project id")?;
+    let failed = get_project(&engine, &failed_id).await?;
+    assert_eq!(failed.status, ProjectStatus::Provisioning);
+    fixture.bad_binding.store(false, Ordering::SeqCst);
+
+    // Validation rejects malformed document input before the native owner is contacted.
+    let before_invalid = fixture.request_count();
+    assert!(invoke(
+        &engine,
+        &owner,
+        "put_document",
+        json!({"project_id":first_id,"document_id":"","collection":"memory","content":"x","media_type":"text/plain"}),
+    )
+    .await
+    .is_err());
+    assert_eq!(fixture.request_count(), before_invalid);
+    assert!(invoke(
+        &engine,
+        &owner,
+        "resolve_context",
+        json!({"mode":"personal","project_id":first_id}),
+    )
+    .await
+    .is_err());
+
+    fixture.finish().await
+}
