+async fn read_http_request(
+    stream: &mut tokio::net::UnixStream,
+) -> anyhow::Result<(String, String, Option<Value>)> {
+    let mut header = Vec::new();
+    while !header.ends_with(b"\r\n\r\n") {
+        header.push(stream.read_u8().await?);
+        anyhow::ensure!(header.len() <= 8192, "fixture request headers too large");
+    }
+    let header = String::from_utf8(header)?;
+    let mut lines = header.split("\r\n");
+    let request = lines.next().unwrap_or_default();
+    let mut request_parts = request.split_whitespace();
+    let method = request_parts.next().unwrap_or_default().to_owned();
+    let path = request_parts.next().unwrap_or_default().to_owned();
+    let headers: HashMap<String, String> = lines
+        .filter_map(|line| line.split_once(':'))
+        .map(|(key, value)| (key.to_ascii_lowercase(), value.trim().to_owned()))
+        .collect();
+    let length = headers
+        .get("content-length")
+        .map(|value| value.parse::<usize>())
+        .transpose()?
+        .unwrap_or(0);
+    anyhow::ensure!(length <= 65536, "fixture request body too large");
+    let mut bytes = vec![0; length];
+    stream.read_exact(&mut bytes).await?;
+    let body = if bytes.is_empty() {
+        None
+    } else {
+        Some(serde_json::from_slice(&bytes)?)
+    };
+    Ok((method, path, body))
+}
+
+async fn write_json_response(
+    stream: &mut tokio::net::UnixStream,
+    value: &Value,
+) -> anyhow::Result<()> {
+    let body = serde_json::to_vec(value)?;
+    let response = format!(
+        "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+        body.len()
+    );
+    stream.write_all(response.as_bytes()).await?;
+    stream.write_all(&body).await?;
+    Ok(())
+}
+
+fn async_operation() -> Value {
+    json!({
+        "type": "async", "status": "Operation created", "status_code": 100,
+        "error": "", "operation": "/1.0/operations/12345678-1234-1234-1234-123456789abc"
+    })
+}
+
+fn sync_metadata(metadata: Value) -> Value {
+    json!({
+        "type": "sync", "status": "Success", "status_code": 200,
+        "error": "", "metadata": metadata
+    })
+}
+
+fn operation_finished() -> Value {
+    sync_metadata(json!({
+        "status": "Success", "status_code": 200, "err": "", "metadata": {}
+    }))
+}
+
+fn instance_metadata(binding: &Binding, bad: bool) -> Value {
+    let owner = if bad {
+        "wrong-owner"
+    } else {
+        binding.owner_session_id.as_str()
+    };
+    let source = if bad {
+        "/tmp/wrong-project-store"
+    } else {
+        binding.persistence_path.as_str()
+    };
+    json!({
+        "name": binding.project_id,
+        "type": "container",
+        "config": {
+            "user.opdbus.role": "project",
+            "user.opdbus.project_id": binding.project_id,
+            "user.opdbus.owner_session_id": owner,
+            "security.privileged": "false",
+            "security.nesting": "false"
+        },
+        "devices": {
+            "project": {"type": "disk", "path": "/project", "source": source, "readonly": "true"}
+        }
+    })
+}
+
+async fn serve_incus_fixture(
+    listener: UnixListener,
+    stop: Arc<Notify>,
+    bad_binding: Arc<AtomicBool>,
+    request_count: Arc<AtomicUsize>,
+    project_ids: Arc<StdMutex<Vec<String>>>,
+    bindings: Arc<StdMutex<HashMap<String, Binding>>>,
+) -> anyhow::Result<()> {
+    loop {
+        let accepted = tokio::select! {
+            _ = stop.notified() => break,
+            accepted = listener.accept() => accepted?,
+        };
+        let (mut stream, _) = accepted;
+        request_count.fetch_add(1, Ordering::SeqCst);
+        let (method, path, body) = read_http_request(&mut stream).await?;
+        match (method.as_str(), path.as_str()) {
+            ("POST", "/1.0/instances") => {
+                let body = body.context("project create body is required")?;
+                let project_id = body["name"].as_str().context("missing project name")?;
+                let owner = body["config"]["user.opdbus.owner_session_id"]
+                    .as_str()
+                    .context("missing project owner")?;
+                let persistence_path = body["devices"]["project"]["source"]
+                    .as_str()
+                    .context("missing project persistence source")?;
+                anyhow::ensure!(uuid::Uuid::parse_str(project_id)?.to_string() == project_id);
+                anyhow::ensure!(body["type"] == "container" && body["ephemeral"] == false);
+                anyhow::ensure!(body["profiles"] == json!([]));
+                anyhow::ensure!(
+                    body["source"]
+                        == json!({
+                            "type": "image", "fingerprint": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+                        })
+                );
+                anyhow::ensure!(body["config"]["boot.autostart"] == "false");
+                anyhow::ensure!(body["config"]["security.privileged"] == "false");
+                anyhow::ensure!(body["config"]["security.nesting"] == "false");
+                anyhow::ensure!(body["config"]["user.opdbus.role"] == "project");
+                anyhow::ensure!(body["config"]["user.opdbus.project_id"] == project_id);
+                anyhow::ensure!(
+                    body["devices"]["root"]
+                        == json!({
+                            "type": "disk", "path": "/", "pool": "fixture-pool"
+                        })
+                );
+                anyhow::ensure!(body["devices"]["project"]["type"] == "disk");
+                anyhow::ensure!(body["devices"]["project"]["path"] == "/project");
+                anyhow::ensure!(body["devices"]["project"]["readonly"] == "true");
+                anyhow::ensure!(body["devices"]["project"]["shift"] == "true");
+                let binding = Binding {
+                    project_id: project_id.to_owned(),
+                    owner_session_id: owner.to_owned(),
+                    persistence_path: persistence_path.to_owned(),
+                };
+                project_ids.lock().unwrap().push(project_id.to_owned());
+                bindings
+                    .lock()
+                    .unwrap()
+                    .insert(project_id.to_owned(), binding);
+                write_json_response(&mut stream, &async_operation()).await?;
+            }
+            ("GET", "/1.0/operations/12345678-1234-1234-1234-123456789abc/wait?timeout=120") => {
+                write_json_response(&mut stream, &operation_finished()).await?;
+            }
+            ("GET", path)
+                if path.starts_with("/1.0/instances/") && path.ends_with("?recursion=1") =>
+            {
+                let project_id = path
+                    .strip_prefix("/1.0/instances/")
+                    .and_then(|value| value.strip_suffix("?recursion=1"))
+                    .context("invalid fixture instance path")?;
+                let binding = bindings
+                    .lock()
+                    .unwrap()
+                    .get(project_id)
+                    .cloned()
+                    .context("fixture has no binding for instance readback")?;
+                write_json_response(
+                    &mut stream,
+                    &sync_metadata(instance_metadata(
+                        &binding,
+                        bad_binding.load(Ordering::SeqCst),
+                    )),
+                )
+                .await?;
+            }
+            _ => anyhow::bail!("unexpected Incus fixture request: {method} {path} {body:?}"),
+        }
+    }
+    Ok(())
+}
+
+fn write_grants(path: &Path, identities: &[(&HumanPrincipalIdentity, &[&str])]) {
+    let document: serde_json::Map<String, Value> = identities
+        .iter()
+        .map(|(identity, capabilities)| {
+            (
+                identity.principal_id.clone(),
+                json!({"capabilities": capabilities}),
+            )
+        })
+        .collect();
+    std::fs::write(path, serde_json::to_vec(&Value::Object(document)).unwrap()).unwrap();
+}
+
+async fn identity(
+    engine: &MutationEngine,
+    byte: u8,
+    name: &str,
+) -> anyhow::Result<HumanPrincipalIdentity> {
+    let key = pk(byte);
+    register(&key, name).await?;
+    let sled = write_identity(engine, &key).await?;
+    Ok(HumanPrincipalIdentity {
+        principal_id: op_identity::session::derive_principal_id(&key),
+        human_pubkey: key,
+        session_id: sled.session_id,
+        session_genesis: sled.genesis.context("identity genesis")?,
+        expires_at: 0,
+    })
+}
