+        let directory = tempfile::tempdir()?;
+        let socket = directory.path().join("incus.sock");
+        let listener = UnixListener::bind(&socket)?;
+        let stop = Arc::new(Notify::new());
+        let bad_binding = Arc::new(AtomicBool::new(false));
+        let request_count = Arc::new(AtomicUsize::new(0));
+        let project_ids = Arc::new(StdMutex::new(Vec::new()));
+        let bindings = Arc::new(StdMutex::new(HashMap::<String, Binding>::new()));
+        let task = tokio::spawn(serve_incus_fixture(
+            listener,
+            stop.clone(),
+            bad_binding.clone(),
+            request_count.clone(),
+            project_ids.clone(),
+            bindings,
+        ));
+        Ok(Self {
+            _directory: directory,
+            socket,
+            stop,
+            bad_binding,
+            request_count,
+            project_ids,
+            task,
+        })
+    }
+
+    fn request_count(&self) -> usize {
+        self.request_count.load(Ordering::SeqCst)
+    }
+
+    async fn finish(self) -> anyhow::Result<()> {
+        self.stop.notify_one();
+        self.task.await??;
+        Ok(())
+    }
+}
