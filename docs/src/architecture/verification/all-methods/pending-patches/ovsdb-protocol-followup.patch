+#[test]
+fn update2_modify_applies_scalar_set_and_map_differences() {
+    let uuid = BRIDGE.to_owned();
+    let columns = BTreeMap::from([(
+        "Bridge".to_owned(),
+        BTreeMap::from([
+            ("name".to_owned(), ColumnKind::Scalar),
+            ("members".to_owned(), ColumnKind::Set),
+            ("metadata".to_owned(), ColumnKind::Map),
+        ]),
+    )]);
+    let selection = ProtocolSelection { columns };
+    let mut snapshot = ProtocolSnapshot {
+        monitor_id: "difference-fixture".into(),
+        method: "monitor_cond".into(),
+        sequence: 1,
+        tables: BTreeMap::from([("Bridge".to_owned(), BTreeMap::new())]),
+    };
+    apply_protocol_update(
+        &mut snapshot,
+        &selection,
+        ProtocolVersion::V2,
+        &json!({"Bridge":{(uuid.clone()):{"initial":{
+            "name":"before",
+            "members":["set",[1,2]],
+            "metadata":["map",[["a",1],["b",2]]]
+        }}}}),
+        true,
+    )
+    .unwrap();
+    apply_protocol_update(
+        &mut snapshot,
+        &selection,
+        ProtocolVersion::V2,
+        &json!({"Bridge":{(uuid.clone()):{"modify":{
+            "name":"after",
+            "members":["set",[2,3]],
+            "metadata":["map",[["a",1],["b",3],["c",4]]]
+        }}}}),
+        false,
+    )
+    .unwrap();
+    let row = &snapshot.tables["Bridge"][&uuid];
+    assert_eq!(row["name"], "after");
+    assert_eq!(row["members"], json!(["set", [1, 3]]));
+    assert_eq!(row["metadata"], json!(["map", [["b", 3], ["c", 4]]]));
+}
