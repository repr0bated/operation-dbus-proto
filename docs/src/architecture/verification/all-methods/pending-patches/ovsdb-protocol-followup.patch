+async fn native_ovsdb() -> NativeOvsdb {
+    let root = tempfile::tempdir().unwrap();
+    let database = root.path().join("db");
+    let socket = root.path().join("db.sock");
+    let output = Command::new("/usr/bin/ovsdb-tool")
+        .args([
+            "create".to_owned(),
+            database.display().to_string(),
+            "/usr/share/openvswitch/vswitch.ovsschema".to_owned(),
+        ])
+        .env("OVS_RUNDIR", root.path())
+        .env("OVS_DBDIR", root.path())
+        .env("OVS_LOGDIR", root.path())
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "ovsdb-tool: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    let server = Command::new("/usr/bin/ovsdb-server")
+        .args([
+            format!("--remote=punix:{}", socket.display()),
+            format!("--pidfile={}", root.path().join("db.pid").display()),
+            format!("--unixctl={}", root.path().join("db.ctl").display()),
+            database.display().to_string(),
+        ])
+        .env("OVS_RUNDIR", root.path())
+        .env("OVS_DBDIR", root.path())
+        .env("OVS_LOGDIR", root.path())
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap();
+    tokio::time::timeout(Duration::from_secs(5), async {
+        while !socket.exists() {
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("private ovsdb-server socket did not appear");
+    let output = Command::new("/usr/bin/ovs-vsctl")
+        .args([
+            format!("--db=unix:{}", socket.display()),
+            "--no-wait".to_owned(),
+            "init".to_owned(),
+        ])
+        .env("OVS_RUNDIR", root.path())
+        .env("OVS_DBDIR", root.path())
+        .env("OVS_LOGDIR", root.path())
+        .output()
+        .unwrap();
+    assert!(
+        output.status.success(),
+        "ovs-vsctl init: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    NativeOvsdb {
+        _root: root,
+        server,
+        socket,
+    }
+}
