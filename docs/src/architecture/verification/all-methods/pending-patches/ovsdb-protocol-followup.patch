+    assert_eq!(v1["method"], "monitor");
+    let v2 = first
+        .call(
+            "monitor_cond",
+            json!({
+                "db_name":"Open_vSwitch",
+                "monitor_id":"canonical-v2",
+                "monitor_cond_requests":{"Bridge":[{
+                    "columns":["name"],
+                    "where":[["name","==","conditional-br"]]
+                }]}
+            }),
+        )
+        .await;
+    assert_eq!(v2["method"], "monitor_cond");
+    let state = wait_state(|state| {
+        monitor(state, "canonical-v1").is_some()
+            && monitor(state, "canonical-v2").is_some()
+            && state["bridges"]
+                .as_array()
+                .is_some_and(|bridges| bridges.iter().any(|bridge| bridge["name"] == "fixture-br"))
+    })
+    .await;
+    assert_eq!(state["monitors"].as_object().unwrap().len(), 2);
+
+    first.call(
+        "create_bridge",
+        json!({"name":"conditional-br","datapath_type":null,"fail_mode":null,"stp_enable":null}),
+    )
+    .await;
+    let state = wait_state(|state| {
+        monitor(state, "canonical-v2").is_some_and(|entry| {
+            entry["tables"]["Bridge"]
+                .as_object()
+                .is_some_and(|rows| rows.values().any(|row| row["name"] == "conditional-br"))
+        })
+    })
+    .await;
+    assert!(monitor(&state, "canonical-v1").is_some());
+    assert!(state["bridges"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .any(|bridge| bridge["name"] == "fixture-br"));
+
+    assert_eq!(
+        first.call("cancel", json!({"id":"canonical-v1"})).await,
+        json!({"monitor_id":"canonical-v1","canceled":true})
+    );
+    let state = wait_state(|state| {
+        monitor(state, "canonical-v1").is_none() && monitor(state, "canonical-v2").is_some()
+    })
+    .await;
+    assert!(state["bridges"].is_array());
+
+    first
+        .call("delete_bridge", json!({"name":"conditional-br"}))
+        .await;
+    wait_state(|state| {
+        monitor(state, "canonical-v2").is_some_and(|entry| {
+            entry["tables"]["Bridge"]
+                .as_object()
+                .is_some_and(serde_json::Map::is_empty)
+        })
+    })
+    .await;
+    first.call("cancel", json!({"id":"canonical-v2"})).await;
+    wait_state(|state| {
+        state["monitors"]
+            .as_object()
+            .is_some_and(serde_json::Map::is_empty)
+            && state["bridges"].is_array()
+    })
+    .await;
+
+    first
+        .call(
+            "remove_port",
+            json!({"bridge":"fixture-br","port":"fixture-port"}),
+        )
+        .await;
+    first
+        .call("delete_bridge", json!({"name":"fixture-br"}))
+        .await;
+    let final_state =
+        wait_state(|state| state["bridges"].as_array().is_some_and(Vec::is_empty)).await;
+    assert!(final_state["monitors"]
+        .as_object()
+        .is_some_and(serde_json::Map::is_empty));
+
+    let cancel = &schema.methods["cancel"];
+    assert!(engine
+        .dispatch_method_call_with_identity(
+            "ovsdb_bridge",
+            "cancel",
+            &json!({"id":"unknown-monitor"}).to_string(),
+            cancel.required_capability.as_deref(),
+            &first_principal,
+            Some(&first_identity.session_id),
+            first_identity.genesis.as_deref(),
+        )
+        .await
+        .is_err());
+}
