+struct Environment(Vec<(&'static str, Option<std::ffi::OsString>)>);
+
+impl Environment {
+    fn set(socket: &Path, grants: &Path) -> Self {
+        let previous = ["OVSDB_SOCKET_ADDR", "OP_GRANTS_PATH"]
+            .into_iter()
+            .map(|key| (key, std::env::var_os(key)))
+            .collect();
+        std::env::set_var("OVSDB_SOCKET_ADDR", format!("unix:{}", socket.display()));
+        std::env::set_var("OP_GRANTS_PATH", grants);
+        Self(previous)
+    }
+}
+
+impl Drop for Environment {
+    fn drop(&mut self) {
+        for (key, value) in self.0.drain(..) {
+            match value {
+                Some(value) => std::env::set_var(key, value),
+                None => std::env::remove_var(key),
+            }
+        }
+    }
+}
+
+async fn call(
+    engine: &crate::mutation_engine::MutationEngine,
+    schema: &PluginSchema,
+    principal: &str,
+    session: &str,
+    genesis: Option<&str>,
+    method: &str,
+    arguments: Value,
+) -> Value {
+    let declaration = &schema.methods[method];
+    let response = engine
+        .dispatch_method_call_with_identity(
+            "ovsdb_bridge",
+            method,
+            &arguments.to_string(),
+            declaration.required_capability.as_deref(),
+            principal,
+            Some(session),
+            genesis,
+        )
+        .await
+        .unwrap_or_else(|error| panic!("ovsdb_bridge.{method}: {error:#}"));
+    let output = &response["result"];
+    let output_schema = serde_json::to_value(declaration.returns.as_ref().unwrap()).unwrap();
+    jsonschema::Validator::new(&output_schema)
+        .unwrap()
+        .validate(output)
+        .unwrap_or_else(|error| panic!("ovsdb_bridge.{method} output: {error}"));
+    output.clone()
+}
+
+struct Caller<'a> {
+    engine: &'a crate::mutation_engine::MutationEngine,
+    schema: &'a PluginSchema,
+    principal: &'a str,
+    session: &'a str,
+    genesis: Option<&'a str>,
+}
+
+impl Caller<'_> {
+    async fn call(&self, method: &str, arguments: Value) -> Value {
+        call(
+            self.engine,
+            self.schema,
+            self.principal,
+            self.session,
+            self.genesis,
+            method,
+            arguments,
+        )
+        .await
+    }
+}
+
+fn committed_state() -> Option<Value> {
+    op_core::projection_shm::read_projection_bytes("ovsdb_bridge")
+        .ok()
+        .and_then(|bytes| serde_json::from_slice(&bytes).ok())
+}
+
+fn monitor<'a>(state: &'a Value, monitor_id: &str) -> Option<&'a Value> {
+    state["monitors"]
+        .as_object()?
+        .values()
+        .find(|entry| entry["monitor_id"] == monitor_id)
+}
+
+async fn wait_state(mut condition: impl FnMut(&Value) -> bool) -> Value {
+    tokio::time::timeout(Duration::from_secs(5), async {
+        loop {
+            if let Some(state) = committed_state().filter(|state| condition(state)) {
+                return state;
+            }
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("timed out waiting for committed OVSDB state")
+}
