+struct NativeOvsdb {
+    _root: tempfile::TempDir,
+    server: Child,
+    socket: PathBuf,
+}
+
+impl Drop for NativeOvsdb {
+    fn drop(&mut self) {
+        let _ = self.server.kill();
+        let _ = self.server.wait();
+    }
+}
