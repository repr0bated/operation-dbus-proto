+#[tokio::test]
+async fn protocol_monitor_forwards_conditional_groups_and_cancels_on_same_connection() {
+    let directory = tempfile::tempdir().unwrap();
+    let socket = directory.path().join("protocol.sock");
+    let listener = UnixListener::bind(&socket).unwrap();
+    let address = format!("unix:{}", socket.display());
+    let requests = json!({
+        "Bridge":[
+            {"columns":["name"],"where":[["name","==","one"]]},
+            {"columns":["name"],"where":[["name","==","two"]],"select":{"initial":true,"insert":true,"delete":true,"modify":true}}
+        ]
+    });
+    let expected_requests = requests.clone();
+    let connecting = tokio::spawn(async move {
+        subscribe_protocol(
+            &address,
+            "Open_vSwitch",
+            "conditional-fixture",
+            "monitor_cond",
+            requests,
+        )
+        .await
+    });
+    let (stream, _) = listener.accept().await.unwrap();
+    let mut peer = Connection::new(Stream::Unix(stream));
+
+    let Message::Request(schema_request) = receive(&mut peer).await else {
+        panic!("expected get_schema request");
+    };
+    assert_eq!(schema_request.method, "get_schema");
+    assert_eq!(schema_request.id, Some(RpcId::Number(1)));
+    peer.send_message(&Message::Response(Response::success(
+        schema_request.id.unwrap(),
+        schema(),
+    )))
+    .await
+    .unwrap();
+
+    let Message::Request(monitor_request) = receive(&mut peer).await else {
+        panic!("expected monitor_cond request");
+    };
+    assert_eq!(monitor_request.method, "monitor_cond");
+    assert_eq!(monitor_request.id, Some(RpcId::Number(2)));
+    assert_eq!(
+        monitor_request.params,
+        json!(["Open_vSwitch", "conditional-fixture", expected_requests])
+    );
+    peer.send_message(&Message::Response(Response::success(
+        monitor_request.id.unwrap(),
+        json!({"Bridge":{(BRIDGE):{"initial":{"name":"one"}}}}),
+    )))
+    .await
+    .unwrap();
+
+    let subscription = connecting.await.unwrap().unwrap();
+    let ProtocolObservation::Snapshot(initial) = subscription.receiver.borrow().clone() else {
+        panic!("expected initial protocol snapshot");
+    };
+    assert_eq!(initial.tables["Bridge"][BRIDGE]["name"], "one");
+
+    let canceling = tokio::spawn(subscription.cancel());
+    let Message::Request(cancel_request) = receive(&mut peer).await else {
+        panic!("expected monitor_cancel request");
+    };
+    assert_eq!(cancel_request.method, "monitor_cancel");
+    assert_eq!(cancel_request.params, json!(["conditional-fixture"]));
+    assert_eq!(cancel_request.id, Some(RpcId::Number(3)));
+    peer.send_message(&Message::Response(Response::success(
+        cancel_request.id.unwrap(),
+        json!({}),
+    )))
+    .await
+    .unwrap();
+    assert_eq!(canceling.await.unwrap().unwrap(), json!({}));
+    assert!(
+        tokio::time::timeout(Duration::from_millis(30), listener.accept())
+            .await
+            .is_err(),
+        "monitor_cancel must not open a fallback connection"
+    );
+}
