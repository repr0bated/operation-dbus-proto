+//! Native, public MongoDB Assistant knowledge coverage.
+//!
+//! This ignored test uses the pinned provider executable and its real public
+//! documentation service. It has no MongoDB connection string, credentials,
+//! user database, or host profile access. Keep this file as a patch artifact;
+//! the repository test module is intentionally not changed by this fixture.
+
+use anyhow::{bail, Context, Result};
+use op_plugins::state_plugins::mongodb_mcp::MongoDbMcpPlugin;
+use op_state::StatePlugin;
+use op_state_store::PluginSchema;
+use serde_json::{json, Value};
+use std::path::{Path, PathBuf};
+use std::process::Stdio;
+use std::time::{Duration, Instant};
+use tokio::net::TcpStream;
+use tokio::process::{Child, Command};
+
+use super::{dispatch_mongodb_mcp_owner, SupervisedMcpProvider};
+
+struct ProviderChild(Option<Child>);
+
+impl Drop for ProviderChild {
+    fn drop(&mut self) {
+        if let Some(child) = self.0.as_mut() {
+            let _ = child.start_kill();
+        }
+    }
+}
+
+impl ProviderChild {
+    async fn stop(&mut self) {
+        let Some(mut child) = self.0.take() else {
+            return;
+        };
+        let _ = child.kill().await;
+        let _ = tokio::time::timeout(Duration::from_secs(3), child.wait()).await;
+    }
+
+    async fn wait_tcp(&mut self, port: u16) -> Result<()> {
+        let deadline = Instant::now() + Duration::from_secs(30);
+        loop {
+            if let Some(status) = self
+                .0
+                .as_mut()
+                .context("knowledge provider child was already stopped")?
+                .try_wait()?
+            {
+                bail!("knowledge provider exited before readiness: {status}");
+            }
+            if Instant::now() >= deadline {
+                bail!("knowledge provider did not bind 127.0.0.1:{port} before deadline");
+            }
+            if TcpStream::connect(("127.0.0.1", port)).await.is_ok() {
+                return Ok(());
+            }
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        }
+    }
+}
+
+fn required_path(name: &str) -> Result<PathBuf> {
+    let path = PathBuf::from(std::env::var_os(name).with_context(|| format!("set {name}"))?);
+    anyhow::ensure!(path.is_file(), "{name} is not a file: {}", path.display());
+    Ok(path)
+}
+
+fn required_dir(name: &str) -> Result<PathBuf> {
+    let path = PathBuf::from(std::env::var_os(name).with_context(|| format!("set {name}"))?);
+    anyhow::ensure!(
+        path.is_dir(),
+        "{name} is not a directory: {}",
+        path.display()
+    );
+    Ok(path)
+}
+
+fn reserve_loopback_ports() -> Result<(std::net::TcpListener, std::net::TcpListener)> {
+    let http = std::net::TcpListener::bind(("127.0.0.1", 0))?;
+    let monitoring = std::net::TcpListener::bind(("127.0.0.1", 0))?;
+    anyhow::ensure!(
+        http.local_addr()?.port() != monitoring.local_addr()?.port(),
+        "knowledge fixture reserved colliding ports"
+    );
+    Ok((http, monitoring))
+}
+
+fn spawn_provider(
+    node: &Path,
+    entry: &Path,
+    provider_root: &Path,
+    root: &Path,
+    http_port: u16,
+    monitoring_port: u16,
+) -> Result<ProviderChild> {
+    let log_path = root.join("provider-logs");
+    let exports_path = root.join("provider-exports");
+    std::fs::create_dir_all(&log_path)?;
+    std::fs::create_dir_all(&exports_path)?;
+
+    // env_clear and explicit provider-owned paths keep HOME absent and avoid
+    // reads/writes of the runner's profile, credentials, or caches.
+    let child = Command::new(node)
+        .env_clear()
+        .env("USER", "fixture")
+        .env("PATH", "/usr/bin:/bin")
+        .env("MDB_MCP_READ_ONLY", "true")
+        .env("MDB_MCP_DISABLE_SERVER_SIDE_JS", "true")
+        .env("MDB_MCP_ALLOW_REQUEST_OVERRIDES", "false")
+        .env("MDB_MCP_TELEMETRY", "disabled")
+        .env("MDB_MCP_LOG_PATH", &log_path)
+        .env("MDB_MCP_EXPORTS_PATH", &exports_path)
+        .env("MDB_MCP_TRANSPORT", "http")
+        .env("MDB_MCP_HTTP_HOST", "127.0.0.1")
+        .env("MDB_MCP_HTTP_PORT", http_port.to_string())
+        .env("MDB_MCP_HTTP_RESPONSE_TYPE", "json")
+        .env("MDB_MCP_MONITORING_SERVER_HOST", "127.0.0.1")
+        .env(
+            "MDB_MCP_MONITORING_SERVER_PORT",
+            monitoring_port.to_string(),
+        )
+        .current_dir(provider_root)
+        .kill_on_drop(true)
+        .arg(entry)
+        .arg("--transport")
+        .arg("http")
+        .arg("--httpHost=127.0.0.1")
+        .arg(format!("--httpPort={http_port}"))
+        .arg("--readOnly")
+        .arg("--loggers")
+        .arg("stderr,mcp")
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .with_context(|| format!("spawn MongoDB MCP provider from {}", entry.display()))?;
+    Ok(ProviderChild(Some(child)))
+}
+
+fn validate_method(schema: &PluginSchema, method: &str, input: &Value, output: &Value) {
+    let declaration = schema
+        .methods
+        .get(method)
+        .unwrap_or_else(|| panic!("MongoDB PluginSchema omitted {method}"));
+    let input_schema = serde_json::to_value(&declaration.args).unwrap();
+    jsonschema::validate(&input_schema, input)
+        .unwrap_or_else(|error| panic!("{method} input violates PluginSchema: {error}"));
+    if let Some(returns) = declaration.returns.as_ref() {
+        let output_schema = serde_json::to_value(returns).unwrap();
+        jsonschema::validate(&output_schema, output)
+            .unwrap_or_else(|error| panic!("{method} output violates PluginSchema: {error}"));
+    }
+}
+
+fn content_texts(output: &Value) -> Vec<&str> {
+    assert_ne!(
+        output["isError"], true,
+        "knowledge tool returned an error: {output}"
+    );
+    output["content"]
+        .as_array()
+        .expect("knowledge result omitted content")
+        .iter()
+        .map(|item| {
+            item["text"]
+                .as_str()
+                .expect("knowledge content omitted text")
+        })
+        .collect()
+}
+
+#[tokio::test]
+#[ignore = "requires OP_MONGODB_MCP_PROVIDER_ENTRY, OP_MONGODB_MCP_PROVIDER_ROOT, and OP_NODE_BIN; reaches knowledge.mongodb.com"]
+async fn native_mongodb_knowledge_methods_round_trip() -> Result<()> {
+    let entry = required_path("OP_MONGODB_MCP_PROVIDER_ENTRY")?;
+    let provider_root = required_dir("OP_MONGODB_MCP_PROVIDER_ROOT")?;
+    let node = required_path("OP_NODE_BIN")?;
+    let root = tempfile::tempdir()?;
+    let schema = MongoDbMcpPlugin::new()
+        .schema()
+        .context("MongoDB plugin has no owning PluginSchema")?;
+    let (http_listener, monitoring_listener) = reserve_loopback_ports()?;
+    let http_port = http_listener.local_addr()?.port();
+    let monitoring_port = monitoring_listener.local_addr()?.port();
+    let mut provider = spawn_provider(
+        &node,
+        &entry,
+        &provider_root,
+        root.path(),
+        http_port,
+        monitoring_port,
+    )?;
+    drop((http_listener, monitoring_listener));
+    provider.wait_tcp(http_port).await?;
+
+    let owner = SupervisedMcpProvider::new("mongodb", format!("http://127.0.0.1:{http_port}/mcp"));
+    let result = tokio::time::timeout(Duration::from_secs(90), async {
+        let list_input = json!({});
+        let list_output =
+            dispatch_mongodb_mcp_owner(&owner, "list_knowledge_sources", list_input.clone())
+                .await?;
+        validate_method(&schema, "list_knowledge_sources", &list_input, &list_output);
+        let list_text = content_texts(&list_output);
+        anyhow::ensure!(
+            list_text
+                .iter()
+                .any(|text| text.contains("Found ") && text.contains("data sources")),
+            "knowledge source response lacked count: {list_output}"
+        );
+        anyhow::ensure!(
+            list_text
+                .iter()
+                .any(|text| text.contains("C Driver") || text.contains("MongoDB Server")),
+            "knowledge source response lacked substantive source data: {list_output}"
+        );
+
+        let search_input = json!({
+            "query": "MongoDB 8.0 supported platforms",
+            "limit": 1
+        });
+        let search_output =
+            dispatch_mongodb_mcp_owner(&owner, "search_knowledge", search_input.clone()).await?;
+        validate_method(&schema, "search_knowledge", &search_input, &search_output);
+        let search_text = content_texts(&search_output);
+        anyhow::ensure!(
+            search_text
+                .iter()
+                .any(|text| text.contains("Found 1 results")),
+            "knowledge search did not return one result: {search_output}"
+        );
+        anyhow::ensure!(
+            search_text.iter().any(|text| {
+                text.contains("Supported Platforms for MongoDB Enterprise")
+                    && text.contains("mongodb.com/docs/enterprise-platform-support")
+            }),
+            "knowledge search lacked the expected documentation result: {search_output}"
+        );
+        Ok::<(), anyhow::Error>(())
+    })
+    .await;
+
+    let mut client = owner.client.lock().await;
+    owner.discard_client(&mut client).await;
+    drop(client);
+    provider.stop().await;
+    result.context("MongoDB knowledge native coverage exceeded its deadline")?
+}
