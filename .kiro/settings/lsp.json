{
  "languages": {
    "rust": {
      "name": "rust-analyzer",
      "command": "/home/jeremy/.cargo/bin/rust-analyzer",
      "args": [],
      "file_extensions": [
        "rs"
      ],
      "project_patterns": [
        "Cargo.toml"
      ],
      "exclude_patterns": [
        "**/target/**"
      ],
      "multi_workspace": false,
      "initialization_options": {
        "cargo": {
          "buildScripts": {
            "enable": true
          }
        },
        "diagnostics": {
          "enable": true
        }
      },
      "request_timeout_secs": 60
    }
  }
}
