{
  "feature": "zeroclaw-absorbs-op-llm",
  "status": "active",
  "created": "2026-06-28",
  "description": "Absorb op-llm into Zeroclaw's dynamic plugin/schema/D-Bus architecture and retire op-llm as an independent crate.",
  "authority": {
    "primary_file": "crates/op-plugins/src/state_plugins/zeroclaw.rs",
    "dbus_object": "/org/opdbus/v1/plugins/zeroclaw",
    "dbus_bus": "org.opdbus.v1",
    "schema_aggregator": "crates/op-plugins/src/state_plugins/plugin_schema_defs.rs",
    "shared_projection_types": "crates/op-plugins/src/state_plugins/common/llm_projection.rs"
  },
  "projection_paths": {
    "individual": "/dev/shm/opdbus/schemas/zeroclaw.json",
    "monolithic": "/dev/shm/live-schema.json"
  },
  "retirement_target": "crates/op-llm",
  "affected_crates": [
    "op-plugins",
    "op-llm",
    "op-chat",
    "op-web",
    "op-grpc-bridge",
    "op-cognitive-mcp"
  ],
  "execution_model": "orchestrated-multi-agent",
  "agents": [
    "coordinator",
    "schema",
    "dbus",
    "provider-absorption",
    "router",
    "caller-migration",
    "projection",
    "test",
    "review"
  ],
  "handoff_files": [
    "handoff-schema.md",
    "handoff-dbus.md",
    "handoff-provider-absorption.md",
    "handoff-router.md",
    "handoff-callers.md",
    "handoff-projection.md",
    "handoff-tests.md",
    "handoff-review.md"
  ],
  "non_goals": [
    "no-separate-op-zeroclaw-crate",
    "no-independent-op-llm-authority-after-migration",
    "no-duplicate-llm-trait-in-op-chat",
    "no-direct-live-state-file-authority",
    "no-sqlite-plugin-catalog",
    "no-new-mcp-shim-service",
    "no-compact-mcp-external-exposure",
    "no-bypass-around-zeroclaw-schema-dbus-authority",
    "no-static-hardcoded-model-picker",
    "no-execution-of-undeclared-models-routes-tools"
  ]
}
