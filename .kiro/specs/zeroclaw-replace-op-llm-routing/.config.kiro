{
  "feature": "zeroclaw-replace-op-llm-routing",
  "version": "1.0.0",
  "created": "2026-06-28",
  "status": "ready",
  "scope": {
    "crates": ["op-plugins", "op-llm"],
    "files": [
      "crates/op-plugins/src/state_plugins/zeroclaw.rs",
      "crates/op-plugins/src/state_plugins/common/llm_projection.rs",
      "crates/op-llm/src/openclaw.rs",
      "crates/op-llm/src/provider.rs"
    ],
    "forbidden_files": [
      "crates/op-plugins/src/state_plugins/plugin_schema_defs.rs",
      "crates/op-plugins/src/state_plugins/common/mod.rs",
      "crates/op-chat/**",
      "crates/op-grpc-bridge/**",
      "crates/op-cognitive-mcp/**",
      "crates/op-web/**"
    ]
  },
  "verify_commands": [
    "cargo check -p op-plugins",
    "cargo check -p op-llm",
    "cargo clippy -p op-plugins -p op-llm -- -D warnings",
    "cargo test -p op-plugins -- zeroclaw",
    "cargo test -p op-llm"
  ],
  "constraints": {
    "no_new_crates": true,
    "no_new_binaries": true,
    "no_op_llm_dep_in_op_plugins": true,
    "no_duplicate_llm_trait": true,
    "compact_mcp_loopback_only": true,
    "plugin_schema_defs_unchanged": true,
    "d_bus_only_control_plane": true
  }
}
