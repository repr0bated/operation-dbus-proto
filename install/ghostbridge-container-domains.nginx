map $http_upgrade $ghostbridge_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name assistant.ghostbridge.tech api.ghostbridge.tech
                dashboard.ghostbridge.tech qdrant.ghostbridge.tech
                broker.ghostbridge.tech;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/snappymail;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name assistant.ghostbridge.tech;

    ssl_certificate /etc/letsencrypt/live/ghostbridge-container-domains/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ghostbridge-container-domains/privkey.pem;

    location / {
        proxy_pass https://188.68.58.237:8443;
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ghostbridge_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }
}

server {
    listen 443 ssl http2;
    server_name api.ghostbridge.tech;

    ssl_certificate /etc/letsencrypt/live/ghostbridge-container-domains/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ghostbridge-container-domains/privkey.pem;

    location / {
        proxy_pass http://188.68.58.237:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 443 ssl http2;
    server_name dashboard.ghostbridge.tech;

    ssl_certificate /etc/letsencrypt/live/ghostbridge-container-domains/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ghostbridge-container-domains/privkey.pem;

    location / {
        proxy_pass http://188.68.58.237:28082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ghostbridge_connection_upgrade;
    }
}

server {
    listen 443 ssl http2;
    server_name qdrant.ghostbridge.tech;

    ssl_certificate /etc/letsencrypt/live/ghostbridge-container-domains/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ghostbridge-container-domains/privkey.pem;

    location / {
        proxy_pass http://188.68.58.237:6333;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}

server {
    listen 443 ssl http2;
    server_name broker.ghostbridge.tech;

    ssl_certificate /etc/letsencrypt/live/ghostbridge-container-domains/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ghostbridge-container-domains/privkey.pem;

    return 503;
}
