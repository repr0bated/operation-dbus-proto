            .ok_or_else(|| anyhow::anyhow!("Missing required field: bridge"))?;

        // Connect to OpenFlow controller (default OVS controller ports)
        let addrs = [
            std::net::SocketAddr::from(([127, 0, 0, 1], 6653)),
