pub async fn run_chat_mcp_server(addr: std::net::SocketAddr, actor: Arc<ChatActor>) -> Result<()> {
    let service = ChatMcpServer::new(actor);
    Server::builder()
        .add_service(McpServiceServer::new(service))
        .serve(addr)
        .await?;
    Ok(())
}
