            if let Some(tag_value) = tag {
                skills.retain(|s| s.tags.iter().any(|t| t.to_lowercase() == tag_value));
            }

            ToolResult::success(
                &request.id,
                json!({ "skills": skills }),
                start.elapsed().as_millis() as u64,
            )
        }
    }

    registry
        .register(SkillListTool {
            registry: Arc::clone(&skill_registry),
