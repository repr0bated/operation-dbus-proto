{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opdbus.org/schemas/plugin/privacy_router.json",
  "title": "Privacy Router Plugin Schema",
  "description": "Privacy-focused router with WireGuard, WARP, and XRay tunnel management",
  "type": "object",
  "required": ["name", "version", "plugin_type"],
  "properties": {
    "name": {
      "type": "string",
      "const": "privacy_router",
      "description": "Plugin identifier"
    },
    "version": {
      "type": "string",
      "default": "1.0.0",
      "description": "Plugin version"
    },
    "plugin_type": {
      "type": "string",
      "const": "network",
      "description": "Plugin type"
    },
    "description": {
      "type": "string",
      "default": "Privacy-focused router with tunnel management",
      "description": "Plugin description"
    },
    "dbus_path": {
      "type": "string",
      "const": "/org/opdbus/v1/plugin/plugins/privacy_router",
      "description": "D-Bus object path"
    },
    "dependencies": {
      "type": "array",
      "default": ["wireguard", "net"],
      "description": "Plugin dependencies"
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "can_read": { "type": "boolean", "default": true },
        "can_write": { "type": "boolean", "default": true },
        "can_delete": { "type": "boolean", "default": false },
        "requires_root": { "type": "boolean", "default": true }
      }
    },
    "wireguard": {
      "type": "object",
      "description": "WireGuard tunnel configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable WireGuard tunnel",
          "default": true
        },
        "container_id": {
          "type": "integer",
          "description": "Container VMID for WireGuard",
          "default": 100
        },
        "listen_port": {
          "type": "integer",
          "description": "WireGuard listen port",
          "default": 51820,
          "minimum": 1,
          "maximum": 65535
        },
        "socket_port": {
          "type": "string",
          "description": "Host-side bridge port name for the WireGuard ingress container",
          "default": "priv_wg"
        }
      }
    },
    "warp": {
      "type": "object",
      "description": "Cloudflare WARP tunnel configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable Cloudflare WARP tunnel",
          "default": true
        },
        "bridge_interface": {
          "type": "string",
          "description": "Host WireGuard interface bridged into OVS for WARP egress",
          "default": "wgcf"
        },
        "wgcf_config": {
          "type": "string",
          "description": "Path to wgcf WireGuard config",
          "default": "/etc/wireguard/wgcf.conf"
        }
      }
    },
    "xray": {
      "type": "object",
      "description": "XRay tunnel configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable system XRay client tunnel",
          "default": true
        },
        "container_id": {
          "type": "integer",
          "description": "Container VMID for the local XRay client",
          "default": 101
        },
        "socket_port": {
          "type": "string",
          "description": "Host-side bridge port for the local XRay client",
          "default": "priv_xray"
        }
      }
    },
    "routing": {
      "type": "object",
      "description": "Routing configuration",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["whitelist", "blacklist", "full_tunnel"],
          "default": "whitelist",
          "description": "Routing mode"
        },
        "domains": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Domains to route through tunnel"
        }
      }
    }
  },
  "example": {
    "name": "privacy_router",
    "version": "1.0.0",
    "plugin_type": "network",
    "description": "Privacy-focused router with tunnel management",
    "dbus_path": "/org/opdbus/v1/plugin/plugins/privacy_router",
    "wireguard": {
      "enabled": true,
      "container_id": 100,
      "listen_port": 51820,
      "socket_port": "priv_wg"
    },
    "warp": {
      "enabled": true,
      "bridge_interface": "wgcf",
      "wgcf_config": "/etc/wireguard/wgcf.conf"
    },
    "xray": {
      "enabled": true,
      "container_id": 101,
      "socket_port": "priv_xray"
    },
    "routing": {
      "mode": "whitelist",
      "domains": ["example.com", "api.example.com"]
    }
  }
}
