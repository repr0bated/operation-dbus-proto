    "ProviderCostRates": {
      "description": "`[cost.rates.providers.*]` — provider-shaped rate sheets. Each field\nhere mirrors a corresponding field on `[providers.*]` with the\ntrailing alias segment replaced by the resource the rate prices.\nThe inner typed wrappers carry the per-provider-type slot layout\nand own dispatch (their slot list is the single source of truth,\nshared with their providers counterpart via the `for_each_*_provider_slot!`\nmacros in [`crate::providers`]).",
      "properties": {
        "models": {
          "$ref": "#/$defs/ModelCostRatesByProvider",
          "default": {},
          "description": "`[cost.rates.providers.models.<type>.<model>]`."
        },
        "transcription": {
          "$ref": "#/$defs/TranscriptionCostRatesByProvider",
          "default": {},
          "description": "`[cost.rates.providers.transcription.<type>.<model>]`."
        },
        "tts": {
          "$ref": "#/$defs/TtsCostRatesByProvider",
          "default": {},
          "description": "`[cost.rates.providers.tts.<type>.<voice>]`."
        }
      },
      "type": "object"
    },
    "ToolCostRates": {
      "description": "Rates for a tool that hits a paid external API. Keyed in\n`[cost.rates.tools.<name>]` by the tool's registered name.",
