{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Incus Container: Xray REALITY Server",
  "description": "Schema for an Xray REALITY inbound server container",
  "type": "object",
  "required": ["name", "version", "plugin_type", "container", "xray"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "plugin_type": {
      "type": "string",
      "const": "network"
    },
    "container": {
      "type": "object",
      "required": ["image", "profiles"],
      "properties": {
        "image": { "type": "string" },
        "profiles": { "type": "array", "items": { "type": "string" } },
        "devices": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        }
      }
    },
    "xray": {
      "type": "object",
      "required": ["inbounds", "outbounds"],
      "properties": {
        "log_level": {
          "type": "string",
          "enum": ["debug", "info", "warning", "error", "none"],
          "default": "warning"
        },
        "inbounds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["protocol", "port", "settings", "stream_settings"],
            "properties": {
              "tag": { "type": "string" },
              "protocol": { "type": "string", "const": "vless" },
              "port": { "type": "integer", "default": 443 },
              "listen": { "type": "string", "default": "0.0.0.0" },
              "settings": {
                "type": "object",
                "required": ["clients"],
                "properties": {
                  "clients": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id", "flow"],
                      "properties": {
                        "id": { "type": "string", "description": "UUID" },
                        "flow": { "type": "string", "const": "xtls-rprx-vision" },
                        "email": { "type": "string" }
                      }
                    }
                  },
                  "decryption": { "type": "string", "const": "none" }
                }
              },
              "stream_settings": {
                "type": "object",
                "required": ["network", "security", "reality_settings"],
                "properties": {
                  "network": { "type": "string", "const": "tcp" },
                  "security": { "type": "string", "const": "reality" },
                  "reality_settings": {
                    "type": "object",
                    "required": ["dest", "server_names", "private_key", "short_ids"],
                    "properties": {
                      "show": { "type": "boolean", "default": false },
                      "dest": {
                        "type": "string",
                        "description": "Fallback destination for non-REALITY traffic, e.g. www.microsoft.com:443"
                      },
                      "server_names": {
                        "type": "array",
                        "items": { "type": "string" },
                        "description": "Allowed SNI values"
                      },
                      "private_key_env": {
                        "type": "string",
                        "description": "Env var name holding the x25519 private key"
                      },
                      "private_key": {
                        "type": "string",
                        "description": "x25519 private key (use private_key_env in production)"
                      },
                      "short_ids": {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "outbounds": {
          "type": "array",
          "description": "Typically a direct freedom outbound",
          "items": {
            "type": "object",
            "required": ["protocol"],
            "properties": {
              "tag": { "type": "string" },
              "protocol": { "type": "string", "enum": ["freedom", "blackhole"] }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "requires_root": { "type": "boolean", "default": false },
        "supports_rollback": { "type": "boolean", "default": false }
      }
    },
    "service": {
      "$ref": "service-plugin-schema.json"
    }
  }
}
