{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "OpenFlow 1.5 Flow Mod",
  "description": "Schema for OpenFlow flow programming via the op-dbus control plane. Based on the official OpenFlow 1.3 schema (dancasey/openflow-schema) extended with OF1.5 packet_type, encap, and decap.",
  "type": "object",
  "definitions": {
    "data": {
      "description": "Arbitrary data as hex string",
      "type": "string",
      "pattern": "^([a-fA-F0-9]{2})+$"
    },
    "optional_data": {
      "description": "Optional data as hex string",
      "type": "string",
      "pattern": "^([a-fA-F0-9]{2})*$"
    },
    "ethernet": {
      "description": "Ethernet address (MAC)",
      "type": "string",
      "pattern": "^([a-fA-F0-9]{2}:?){5}[a-fA-F0-9]{2}$"
    },
    "oxm_class": {
      "type": "string",
      "default": "OFPXMC_OPENFLOW_BASIC",
      "enum": [
        "OFPXMC_NXM_0",
        "OFPXMC_NXM_1",
        "OFPXMC_OPENFLOW_BASIC",
        "OFPXMC_EXPERIMENTER"
      ]
    },
    "oxm_field_type": {
      "type": "string",
      "default": "OFPXMT_OFB_IN_PORT",
      "enum": [
        "OFPXMT_OFB_IN_PORT",
        "OFPXMT_OFB_IN_PHY_PORT",
        "OFPXMT_OFB_METADATA",
        "OFPXMT_OFB_ETH_DST",
        "OFPXMT_OFB_ETH_SRC",
        "OFPXMT_OFB_ETH_TYPE",
        "OFPXMT_OFB_VLAN_VID",
        "OFPXMT_OFB_VLAN_PCP",
        "OFPXMT_OFB_IP_DSCP",
        "OFPXMT_OFB_IP_ECN",
        "OFPXMT_OFB_IP_PROTO",
        "OFPXMT_OFB_IPV4_SRC",
        "OFPXMT_OFB_IPV4_DST",
        "OFPXMT_OFB_TCP_SRC",
        "OFPXMT_OFB_TCP_DST",
        "OFPXMT_OFB_UDP_SRC",
        "OFPXMT_OFB_UDP_DST",
        "OFPXMT_OFB_SCTP_SRC",
        "OFPXMT_OFB_SCTP_DST",
        "OFPXMT_OFB_ICMPV4_TYPE",
        "OFPXMT_OFB_ICMPV4_CODE",
        "OFPXMT_OFB_ARP_OP",
        "OFPXMT_OFB_ARP_SPA",
        "OFPXMT_OFB_ARP_TPA",
        "OFPXMT_OFB_ARP_SHA",
        "OFPXMT_OFB_ARP_THA",
        "OFPXMT_OFB_IPV6_SRC",
        "OFPXMT_OFB_IPV6_DST",
        "OFPXMT_OFB_IPV6_FLABEL",
        "OFPXMT_OFB_ICMPV6_TYPE",
        "OFPXMT_OFB_ICMPV6_CODE",
        "OFPXMT_OFB_IPV6_ND_TARGET",
        "OFPXMT_OFB_IPV6_ND_SLL",
        "OFPXMT_OFB_IPV6_ND_TLL",
        "OFPXMT_OFB_MPLS_LABEL",
        "OFPXMT_OFB_MPLS_TC",
        "OFPXMT_OFB_MPLS_BOS",
        "OFPXMT_OFB_PBB_ISID",
        "OFPXMT_OFB_TUNNEL_ID",
        "OFPXMT_OFB_IPV6_EXTHDR",
        "OFPXMT_OFB_PACKET_TYPE"
      ]
    },
    "oxm_field": {
      "type": "object",
      "required": ["oxm_class", "oxm_field", "oxm_hasmask", "oxm_length"],
      "properties": {
        "oxm_class": { "$ref": "#/definitions/oxm_class" },
        "oxm_field": { "$ref": "#/definitions/oxm_field_type" },
        "oxm_hasmask": { "type": "boolean", "default": false },
        "oxm_length": { "type": "integer", "minimum": 0, "maximum": 255 },
        "oxm_value": { "type": "string", "description": "Field value (hex string or decimal for simple integers)" },
        "oxm_mask": { "type": "string", "description": "Optional mask (hex string)" }
      }
    },
    "ofp_match": {
      "type": "object",
      "required": ["match_type", "length"],
      "properties": {
        "match_type": {
          "type": "string",
          "default": "OFPMT_OXM",
          "enum": ["OFPMT_STANDARD", "OFPMT_OXM"]
        },
        "length": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 4 },
        "oxm_fields": {
          "type": "array",
          "items": { "$ref": "#/definitions/oxm_field" }
        }
      }
    },
    "flow_mod_command": {
      "type": "string",
      "default": "OFPFC_ADD",
      "enum": ["OFPFC_ADD", "OFPFC_MODIFY", "OFPFC_MODIFY_STRICT", "OFPFC_DELETE", "OFPFC_DELETE_STRICT"]
    },
    "flow_mod_flag": {
      "type": "string",
      "enum": [
        "OFPFF_SEND_FLOW_REM",
        "OFPFF_CHECK_OVERLAP",
        "OFPFF_RESET_COUNTS",
        "OFPFF_NO_PKT_COUNTS",
        "OFPFF_NO_BYT_COUNTS"
      ]
    },
    "action_type": {
      "type": "string",
      "enum": [
        "OFPAT_OUTPUT",
        "OFPAT_COPY_TTL_OUT",
        "OFPAT_COPY_TTL_IN",
        "OFPAT_SET_MPLS_TTL",
        "OFPAT_DEC_MPLS_TTL",
        "OFPAT_PUSH_VLAN",
        "OFPAT_POP_VLAN",
        "OFPAT_PUSH_MPLS",
        "OFPAT_POP_MPLS",
        "OFPAT_SET_QUEUE",
        "OFPAT_GROUP",
        "OFPAT_SET_NW_TTL",
        "OFPAT_DEC_NW_TTL",
        "OFPAT_SET_FIELD",
        "OFPAT_PUSH_PBB",
        "OFPAT_POP_PBB",
        "OFPAT_ENCAP",
        "OFPAT_DECAP",
        "OFPAT_EXPERIMENTER"
      ]
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/definitions/action_type" },
        "port": { "type": "string", "description": "Output port name or number (for OFPAT_OUTPUT). Special: LOCAL, NORMAL, FLOOD, ALL, IN_PORT, CONTROLLER, ANY" },
        "group_id": { "type": "integer", "description": "Group ID (for OFPAT_GROUP)" },
        "field": { "type": "string", "description": "Field name (for OFPAT_SET_FIELD), e.g. eth_dst, nw_src, vlan_vid" },
        "value": { "type": "string", "description": "Field value (for OFPAT_SET_FIELD)" },
        "ether_type": { "type": "string", "description": "Encap ether type (for OFPAT_ENCAP), e.g. ethernet=1" },
        "ethertype": { "type": "integer", "description": "EtherType (for OFPAT_PUSH_VLAN / OFPAT_PUSH_MPLS)" },
        "mpls_ttl": { "type": "integer", "description": "MPLS TTL (for OFPAT_SET_MPLS_TTL)" },
        "nw_ttl": { "type": "integer", "description": "Network TTL (for OFPAT_SET_NW_TTL)" },
        "queue_id": { "type": "integer", "description": "Queue ID (for OFPAT_SET_QUEUE)" },
        "experimenter_id": { "type": "integer", "description": "Experimenter ID (for OFPAT_EXPERIMENTER)" },
        "experimenter_data": { "type": "string", "description": "Experimenter data as hex (for OFPAT_EXPERIMENTER)" }
      }
    },
    "ofp_flow_mod": {
      "type": "object",
      "required": ["table_id", "command", "idle_timeout", "hard_timeout", "priority", "match"],
      "properties": {
        "cookie": { "type": "string", "pattern": "^[a-fA-F0-9]{16}$", "default": "0000000000000000" },
        "cookie_mask": { "type": "string", "pattern": "^[a-fA-F0-9]{16}$", "default": "0000000000000000" },
        "table_id": { "type": "integer", "minimum": 0, "maximum": 255, "default": 0 },
        "command": { "$ref": "#/definitions/flow_mod_command" },
        "idle_timeout": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 0 },
        "hard_timeout": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 0 },
        "priority": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 0 },
        "buffer_id": { "type": "integer", "minimum": 0, "maximum": 4294967295, "default": 4294967295 },
        "out_port": { "type": "integer", "minimum": 0, "maximum": 4294967295, "default": 4294967295 },
        "out_group": { "type": "integer", "minimum": 0, "maximum": 4294967295, "default": 4294967295 },
        "flags": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/definitions/flow_mod_flag" }
        },
        "match": { "$ref": "#/definitions/ofp_match" },
        "actions": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/definitions/action" }
        }
      }
    }
  },
  "properties": {
    "bridge": { "type": "string", "description": "Bridge name" },
    "flow_mod": { "$ref": "#/definitions/ofp_flow_mod" }
  },
  "required": ["bridge", "flow_mod"]
}
