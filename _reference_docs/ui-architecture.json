  "zustandStore": {
    "file": "src/stores/event-store.ts",
    "interface": "EventStore",
    "stateFields": {
      "connected": {
        "type": "boolean",
        "description": "Whether any gRPC stream is connected"
      },
      "health": {
        "type": "HealthSnapshot | null",
        "description": "Last health check result"
      },
      "logs": {
        "type": "LogEntry[]",
        "maxSize": 1000,
        "description": "Rolling log buffer"
      },
      "agents": {
        "type": "Agent[]",
        "description": "Registered agents"
      },
      "events": {
        "type": "EventLogEntry[]",
        "maxSize": 500,
        "description": "Rolling event buffer"
      },
      "lastError": {
        "type": "string | null",
        "description": "Last error message"
      },
      "eventCounts": {
        "type": "Record<string, number>",
        "description": "Counters per event type (state_update, audit_event, registry_event, system_stats)"
      },
      "latestState": {
        "type": "Record<string, unknown>",
        "description": "Projected D-Bus state tree. Keys: plugin.property, ovsdb.table.uuid, agents[]"
      },
      "latestStats": {
        "type": "Record<string, unknown> | null",
        "description": "Runtime metrics keyed by category.name.labels"
      }
    },
    "mutations": [
      "setConnected",
      "setHealth",
      "addLog",
      "setLogs",
      "setAgents",
      "addEvent",
      "setError",
      "clearLogs",
      "updateState",
      "setStats",
      "incrementEventCount"
    ]
  },
  "globalStreams": {
    "hookFile": "src/hooks/use-event-stream.ts (308 lines)",
    "description": "5 server-side gRPC streams connected on app mount, feeding Zustand store",
    "streams": [
      {
        "name": "StateSync.Subscribe",
        "protoPath": "operation.v1.StateSync/Subscribe",
        "request": {
          "includeInitialState": true
        },
        "responseType": "StateChange",
        "storeTarget": "latestState[pluginId.memberName]",
        "eventType": "state_update",
        "description": "D-Bus property changes mirrored via DbusWatcher"
      },
      {
        "name": "EventChain.SubscribeEvents",
        "protoPath": "operation.v1.EventChainService/SubscribeEvents",
        "request": {
          "fromEventId": 0
        },
        "responseType": "ChainEvent",
        "storeTarget": "events[]",
        "eventType": "audit_event",
        "description": "Immutable audit ledger events with hash chain"
      },
      {
        "name": "OvsdbMirror.Monitor",
        "protoPath": "operation.v1.OvsdbMirror/Monitor",
        "request": {
          "database": "Open_vSwitch",
          "monitorRequestsJson": "{Bridge:{},Port:{},Interface:{}}"
        },
        "responseType": "OvsdbUpdate",
        "storeTarget": "latestState[ovsdb.table.uuid]",
        "eventType": "state_update",
        "description": "OVS bridge/port/interface real-time changes"
      },
      {
        "name": "RuntimeMirror.StreamMetrics",
        "protoPath": "operation.v1.RuntimeMirror/StreamMetrics",
        "request": {
          "intervalSeconds": 5,
          "categories": []
        },
        "responseType": "RuntimeMetricUpdate",
        "storeTarget": "latestStats[category.name.labels]",
        "eventType": "system_stats",
        "description": "CPU, memory, network metrics at 5s intervals"
      },
      {
        "name": "ComponentRegistry.Watch",
        "protoPath": "operation.registry.v1.ComponentRegistry/Watch",
        "request": {
          "componentTypes": [],
          "includeExisting": true
        },
        "responseType": "RegistryEvent",
        "storeTarget": "latestState[agents[]]",
        "eventType": "registry_event",
        "description": "Live agent/component registration, deregistration, heartbeat"
      }
    ]
  },
