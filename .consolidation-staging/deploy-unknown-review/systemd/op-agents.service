[Unit]
Description=OP-Agents Service
Documentation=https://github.com/repr0bated/operation-dbus
After=network.target op-dbus.service
Requires=op-dbus.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/op-agent-manager
Restart=on-failure
RestartSec=5s

# Environment
EnvironmentFile=-/etc/op-dbus/environment
WorkingDirectory=/var/lib/op-dbus

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/op-dbus /var/log/op-dbus

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dbus-agent

[Install]
WantedBy=multi-user.target
