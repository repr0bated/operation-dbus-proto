#!/bin/execlineb -P
envfile -I /etc/s6/config/op-web.conf
importas -sCuD "n5 s2000000 T" DIRECTIVES DIRECTIVES
ifelse { test -w /var/log } {
	foreground { install -d -o s6log -g s6log /var/log/op-web }
	s6-setuidgid s6log exec -c s6-log -d3 -b -- ${DIRECTIVES} /var/log/op-web
}
foreground { install -d -o s6log -g s6log /run/log/op-web }
s6-setuidgid s6log exec -c s6-log -d3 -b -- ${DIRECTIVES} /run/log/op-web
